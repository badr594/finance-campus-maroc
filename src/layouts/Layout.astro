---
const { title } = Astro.props;
---

<!html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-emerald-500 selection:text-slate-950">
    
    {/* Navigation Mobile & Desktop */}
    <header class="border-b border-slate-800/80 bg-slate-950/95 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
        
        {/* Titre / Logo */}
        <a href="/" class="text-base font-extrabold text-white tracking-tight text-center sm:text-left">
          Finance Campus <span class="text-emerald-400">Maroc</span>
        </a>

        {/* Barre de Liens toujours visibles et adaptés sur téléphone */}
        <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-xs sm:text-sm font-semibold text-slate-300">
          <a href="/" class="hover:text-emerald-400 transition py-1">Accueil</a>
          <a href="/cours" class="hover:text-emerald-400 transition py-1">Cours</a>
          <a href="/investissement" class="hover:text-emerald-400 transition py-1">Investissement</a>
          <a href="/dictionnaire" class="hover:text-emerald-400 transition py-1">Dictionnaire</a>
          <a href="/contact" class="hover:text-emerald-400 transition py-1">Contact</a>
        </nav>

      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    {/* Footer */}
    <footer class="border-t border-slate-800/80 py-6 text-center text-xs text-slate-500">
      <p>Finance Campus Maroc • Club Finance ENCG Tanger</p>
    </footer>

  </body>
</html>