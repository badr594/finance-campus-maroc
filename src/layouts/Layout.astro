---
const { title } = Astro.props;
---

<!html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Importation de Tailwind CSS via CDN pour garantir que le style s'affiche instantanément -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans selection:bg-emerald-500 selection:text-slate-950">
    
    {/* En-tête / Navigation responsive */}
    <header class="border-b border-slate-800/80 bg-slate-950/95 sticky top-0 z-50 backdrop-blur-md">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        
        {/* Logo / Nom du site */}
        <a href="/" class="text-base font-extrabold text-white tracking-tight flex items-center gap-2">
          Finance Campus <span class="text-emerald-400">Maroc</span>
        </a>

        {/* Bouton Menu Burger pour Téléphone */}
        <button 
          id="menu-toggle" 
          class="md:hidden px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-bold text-emerald-400 cursor-pointer"
        >
          Menu
        </button>

        {/* Navigation Desktop */}
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-emerald-400 transition">Accueil</a>
          <a href="/cours" class="hover:text-emerald-400 transition">Cours</a>
          <a href="/investissement" class="hover:text-emerald-400 transition">Investissement</a>
          <a href="/dictionnaire" class="hover:text-emerald-400 transition">Dictionnaire</a>
          <a href="/contact" class="hover:text-emerald-400 transition">Contact</a>
        </nav>

      </div>

      {/* Menu Mobile Déroulant (S'ouvre au clic sur le bouton Menu) */}
      <div id="mobile-menu" class="hidden md:hidden px-6 py-4 bg-slate-900 border-t border-slate-800 space-y-3">
        <a href="/" class="block text-sm font-medium text-slate-300 hover:text-emerald-400 py-1">Accueil</a>
        <a href="/cours" class="block text-sm font-medium text-slate-300 hover:text-emerald-400 py-1">Cours</a>
        <a href="/investissement" class="block text-sm font-medium text-slate-300 hover:text-emerald-400 py-1">Investissement</a>
        <a href="/dictionnaire" class="block text-sm font-medium text-slate-300 hover:text-emerald-400 py-1">Dictionnaire</a>
        <a href="/contact" class="block text-sm font-medium text-slate-300 hover:text-emerald-400 py-1">Contact</a>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    {/* Pied de page */}
    <footer class="border-t border-slate-800/80 py-8 text-center text-xs text-slate-500">
      <p>Finance Campus Maroc • Club Finance ENCG Tanger</p>
    </footer>

  </body>
</html>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>