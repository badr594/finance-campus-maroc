---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Finance Campus Maroc">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 inline-block mb-3">
        Restons en contact
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4 tracking-tight">
        Contactez l'équipe
      </h1>
      <p class="text-slate-400 text-sm leading-relaxed">
        Une question sur nos formations, un partenariat ou un projet ? Remplissez le formulaire ci-dessous, nous vous répondrons rapidement.
      </p>
    </div>

    {/* Formulaire relié à Formspree */}
    <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-sm">
      <form action="https://formspree.io/f/TON_FORM_ID" method="POST" class="space-y-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Nom complet</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="Ex: Badr Mohamed"
              class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Adresse E-mail</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="exemple@domaine.com"
              class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Sujet</label>
          <input 
            type="text" 
            id="subject" 
            name="subject" 
            required 
            placeholder="Objet de votre message"
            class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Message</label>
          <textarea 
            id="message" 
            name="message" 
            rows="5" 
            required 
            placeholder="Rédigez votre message ici..."
            class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition resize-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full py-4 rounded-xl text-sm font-bold bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20 cursor-pointer"
        >
          Envoyer le message &rarr;
        </button>

      </form>
    </div>

  </section>
</Layout>