---
---

<section class="max-w-7xl mx-auto px-6 py-16 border-t border-slate-800/80">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
      Permanence et Secrétariat
    </span>
    <h2 class="text-2xl md:text-4xl font-extrabold text-white mb-4 tracking-tight">
      Contactez le Club Finance
    </h2>
    <p class="text-slate-400 text-xs md:text-sm leading-relaxed text-justify">
      Vous êtes étudiant à l'ENCG Tanger, partenaire institutionnel ou professionnel intéressé par nos activités ? Notre équipe du secrétariat et du bureau exécutif reste à votre entière disposition pour toute information relative au mandat 2026/2027.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
    
    {/* Bloc Localisation */}
    <div class="p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl flex flex-col justify-between">
      <div>
        <h3 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-2">Localisation</h3>
        <p class="text-slate-300 text-xs leading-relaxed text-justify">
          École Nationale de Commerce et de Gestion de Tanger (ENCG Tanger), B.P. 1255, Tanger Principal, Maroc.
        </p>
      </div>
    </div>

    {/* Bloc Secretariat */}
    <div class="p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl flex flex-col justify-between">
      <div>
        <h3 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-2">Secrétariat Général</h3>
        <p class="text-slate-300 text-xs leading-relaxed text-justify">
          Permanence assurée du lundi au vendredi de 09h00 à 17h00 pour le traitement des demandes d'adhésion et des partenariats.
        </p>
      </div>
    </div>

    {/* Bloc Email */}
    <div class="p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl flex flex-col justify-between">
      <div>
        <h3 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-2">Courrier Électronique</h3>
        <p class="text-slate-300 text-xs leading-relaxed text-justify mb-4">
          Pour toute proposition de projet, question sur les formations ou collaboration institutionnelle.
        </p>
        <span class="text-xs font-semibold text-white bg-slate-900/80 px-3 py-2 rounded-xl border border-slate-700 block text-center">
          contact@clubfinance-encgt.ma
        </span>
      </div>
    </div>

  </div>
</section>