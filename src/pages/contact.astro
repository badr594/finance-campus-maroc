---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Club Finance ENCG Tanger">
  <main class="max-w-7xl mx-auto px-6 py-16">
    {/* En-tête */}
    <div class="mb-12 text-center max-w-3xl mx-auto">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-4">
        Restons en contact
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        Contactez le <span class="text-emerald-500">Club Finance</span>
      </h1>
      <p class="text-slate-400 text-base">
        Une question sur nos activités, nos cours ou une proposition de partenariat ? Envoyez-nous un message ou rejoignez-nous sur nos réseaux sociaux.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      {/* Informations de contact */}
      <div class="space-y-6">
        <div class="bg-slate-800/40 border border-slate-700/60 rounded-2xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold mb-4">
            📍
          </div>
          <h3 class="text-white font-semibold text-lg mb-1">Localisation</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            École Nationale de Commerce et de Gestion (ENCG Tanger)<br />
            Route de l'Aéroport, B.P. 1255, Tanger - Maroc
          </p>
        </div>

        <div class="bg-slate-800/40 border border-slate-700/60 rounded-2xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold mb-4">
            ✉️
          </div>
          <h3 class="text-white font-semibold text-lg mb-1">Adresse E-mail</h3>
          <p class="text-slate-400 text-sm">
            club.finance@encgt.ma
          </p>
        </div>

        <div class="bg-slate-800/40 border border-slate-700/60 rounded-2xl p-6">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold mb-4">
            🌐
          </div>
          <h3 class="text-white font-semibold text-lg mb-2">Réseaux Sociaux</h3>
          <div class="flex space-x-4 text-sm text-emerald-400">
            <a href="#" class="hover:underline">LinkedIn</a>
            <span>•</span>
            <a href="#" class="hover:underline">Instagram</a>
            <span>•</span>
            <a href="#" class="hover:underline">Facebook</a>
          </div>
        </div>
      </div>

      {/* Formulaire de contact */}
      <div class="lg:col-span-2 bg-slate-800/40 border border-slate-700/60 rounded-2xl p-8">
        <h2 class="text-xl font-bold text-white mb-6">Envoyez-nous un message</h2>
        
        <form class="space-y-5">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-2">Nom Complet</label>
              <input 
                type="text" 
                placeholder="Votre nom" 
                class="w-full bg-slate-900 border border-slate-700/80 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-2">Adresse E-mail</label>
              <input 
                type="email" 
                placeholder="nom@exemple.com" 
                class="w-full bg-slate-900 border border-slate-700/80 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">Sujet</label>
            <input 
              type="text" 
              placeholder="Ex: Partenariat, Question sur un cours..." 
              class="w-full bg-slate-900 border border-slate-700/80 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">Message</label>
            <textarea 
              rows="5" 
              placeholder="Écrivez votre message ici..." 
              class="w-full bg-slate-900 border border-slate-700/80 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
            ></textarea>
          </div>

          <button 
            type="button" 
            class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-bold rounded-xl transition duration-200"
          >
            Envoyer le message
          </button>
        </form>
      </div>
    </div>
  </main>
</Layout>