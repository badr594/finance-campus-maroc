---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Club Finance ENCG Tanger">
  <section class="max-w-7xl mx-auto px-6 py-12">
    
    {/* En-tête de la page */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Permanence & Secrétariat
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Contactez le Club Finance
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed text-justify">
        Vous êtes étudiant à l'ENCG Tanger, partenaire institutionnel ou professionnel intéressé par nos activités ? Notre équipe du secrétariat et du bureau exécutif reste à votre entière disposition pour toute information relative au mandat 2026/2027.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start max-w-6xl mx-auto">
      
      {/* Colonne Gauche : Informations institutionnelles */}
      <div class="lg:col-span-5 space-y-8 bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm">
        
        <div>
          <h2 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-2">Localisation</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            École Nationale de Commerce et de Gestion de Tanger (ENCG Tanger), B.P. 1255, Tanger Principal, Maroc.
          </p>
        </div>

        <hr class="border-slate-700/60" />

        <div>
          <h2 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-2">Secrétariat Général</h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Permanence assurée du lundi au vendredi de 09h00 à 17h00 pour le traitement des demandes d'adhésion et des partenariats.
          </p>
        </div>

        <hr class="border-slate-700/60" />

        <div>
          <h2 class="text-sm font-bold text-emerald-400 uppercase tracking-wider mb-2">Courrier Électronique</h2>
          <p class="text-slate-300 text-sm leading-relaxed mb-3">
            Pour toute proposition de projet, question sur les formations ou collaboration institutionnelle.
          </p>
          <a href="mailto:encgtfinanceclub@gmail.com" class="inline-flex items-center gap-2 text-emerald-400 hover:text-emerald-300 text-sm font-semibold transition">
            encgtfinanceclub@gmail.com &rarr;
          </a>
        </div>

      </div>

      {/* Colonne Droite : Formulaire interactif Formspree */}
      <div class="lg:col-span-7 bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 md:p-10 shadow-2xl backdrop-blur-sm">
        <h2 class="text-xl font-bold text-white mb-6">Envoyez-nous un message</h2>
        
        <form action="https://formspree.io/f/TON_FORM_ID" method="POST" class="space-y-6">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Nom complet</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                placeholder="Votre nom et prénom"
                class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Adresse E-mail</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="nom@domaine.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Sujet</label>
            <input 
              type="text" 
              id="subject" 
              name="subject" 
              required 
              placeholder="Ex: Demande de partenariat / Question académique"
              class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Message</label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required 
              placeholder="Rédigez votre message ici..."
              class="w-full px-4 py-3 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-4 rounded-xl text-sm font-bold bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20 cursor-pointer"
          >
            Envoyer le message &rarr;
          </button>

        </form>
      </div>

    </div>
  </section>
</Layout>