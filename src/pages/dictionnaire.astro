---
import Layout from '../layouts/Layout.astro';

const termesFinanciers = [
  "Action (finance)",
  "Obligation (finance)",
  "OPCVM",
  "Bourse des valeurs",
  "Portefeuille (finance)",
  "Inflation"
];
---

<Layout title="Dictionnaire Financier - Club Finance">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    {/* En-tête */}
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Lexique & Définitions
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4">
        Dictionnaire Financier Wikipédia
      </h1>
      <p class="text-slate-400 text-sm">
        Consultez instantanément les définitions officielles issues de Wikipédia pour enrichir vos connaissances financières.
      </p>
    </div>

    {/* Barre de recherche */}
    <div class="mb-8">
      <div class="flex gap-3">
        <input 
          type="text" 
          id="wiki-search-input" 
          placeholder="Ex: Action, Obligation, OPCVM..." 
          class="w-full px-5 py-3.5 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
        />
        <button 
          id="wiki-search-btn"
          class="px-6 py-3.5 rounded-xl bg-emerald-500 text-slate-950 font-bold text-sm hover:bg-emerald-400 transition cursor-pointer"
        >
          Chercher
        </button>
      </div>
      
      {/* Suggestions rapides */}
      <div class="flex flex-wrap gap-2 mt-4 items-center text-xs text-slate-400">
        <span>Suggestions :</span>
        {termesFinanciers.map(terme => (
          <button 
            class="tag-btn px-3 py-1 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition cursor-pointer"
            data-term={terme}
          >
            {terme.replace(' (finance)', '')}
          </button>
        ))}
      </div>
    </div>

    {/* Zone d'affichage du résultat unique */}
    <div 
      id="wiki-result-card" 
      class="hidden bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm shadow-xl"
    >
      <div class="flex items-center justify-between mb-4 pb-4 border-b border-slate-700/50">
        <h2 id="wiki-title" class="text-2xl font-bold text-emerald-400"></h2>
        <span class="text-xs bg-blue-500/10 text-blue-400 border border-blue-500/30 px-3 py-1 rounded-full font-semibold">
          Source : Wikipédia
        </span>
      </div>

      <div id="wiki-content" class="text-slate-300 text-sm leading-relaxed space-y-4">
        {/* Le texte de Wikipédia s'affiche ici */}
      </div>

      <div class="mt-6 pt-4 border-t border-slate-700/50 flex justify-end">
        <a 
          id="wiki-link" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-xs font-semibold text-emerald-400 hover:underline inline-flex items-center gap-1"
        >
          Lire l'article complet sur Wikipédia &rarr;
        </a>
      </div>
    </div>

    {/* Message d'état / Loader */}
    <div id="wiki-status" class="text-center text-slate-500 text-sm py-12">
      Entrez un mot-clé ou cliquez sur une suggestion pour afficher la définition.
    </div>

  </section>
</Layout>

<script>
  const searchInput = document.getElementById('wiki-search-input') as HTMLInputElement;
  const searchBtn = document.getElementById('wiki-search-btn');
  const resultCard = document.getElementById('wiki-result-card');
  const wikiTitle = document.getElementById('wiki-title');
  const wikiContent = document.getElementById('wiki-content');
  const wikiLink = document.getElementById('wiki-link') as HTMLAnchorElement;
  const wikiStatus = document.getElementById('wiki-status');
  const tagBtns = document.querySelectorAll('.tag-btn');

  async function fetchWikipediaDefinition(term: string) {
    if (!term.trim()) return;

    if (wikiStatus) {
      wikiStatus.textContent = "Recherche en cours sur Wikipédia...";
      wikiStatus.classList.remove('hidden');
    }
    if (resultCard) resultCard.classList.add('hidden');

    try {
      const encodedTerm = encodeURIComponent(term.trim());
      const response = await fetch(`https://fr.wikipedia.org/api/rest_v1/page/summary/${encodedTerm}`);

      if (!response.ok) {
        throw new Error('Non trouvé');
      }

      const data = await response.json();

      if (wikiTitle) wikiTitle.textContent = data.title;
      if (wikiContent) {
        wikiContent.innerHTML = `<p class="text-base leading-relaxed">${data.extract}</p>`;
      }
      if (wikiLink) {
        wikiLink.href = data.content_urls?.desktop?.page || `https://fr.wikipedia.org/wiki/${encodedTerm}`;
      }

      if (wikiStatus) wikiStatus.classList.add('hidden');
      if (resultCard) resultCard.classList.remove('hidden');

    } catch (error) {
      if (wikiStatus) {
        wikiStatus.textContent = `Aucune définition Wikipédia trouvée pour "${term}". Essayez d'ajouter "finance" (ex: Action finance).`;
        wikiStatus.classList.remove('hidden');
      }
      if (resultCard) resultCard.classList.add('hidden');
    }
  }

  searchBtn?.addEventListener('click', () => fetchWikipediaDefinition(searchInput.value));
  searchInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') fetchWikipediaDefinition(searchInput.value);
  });

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const term = btn.getAttribute('data-term') || '';
      searchInput.value = term;
      fetchWikipediaDefinition(term);
    });
  });
</script>