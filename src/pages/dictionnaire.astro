---
import Layout from '../layouts/Layout.astro';

const termesFinanciers = [
  "Action",
  "Obligation",
  "OPCVM",
  "Bourse",
  "Inflation",
  "Portefeuille"
];
---

<Layout title="Dictionnaire Multi-Sources - Finance Campus Maroc">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    {/* En-tête */}
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Lexique Multi-Sources
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4">
        Dictionnaire Financier
      </h1>
      <p class="text-slate-400 text-sm">
        Recherchez un terme pour afficher simultanément les définitions de chaque source dans des cartes séparées.
      </p>
    </div>

    {/* Barre de recherche */}
    <div class="mb-8">
      <div class="flex gap-3">
        <input 
          type="text" 
          id="dict-search-input" 
          placeholder="Ex: Action, Obligation, Inflation..." 
          class="w-full px-5 py-3.5 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
        />
        <button 
          id="dict-search-btn"
          class="px-6 py-3.5 rounded-xl bg-emerald-500 text-slate-950 font-bold text-sm hover:bg-emerald-400 transition cursor-pointer"
        >
          Chercher
        </button>
      </div>
      
      {/* Suggestions rapides */}
      <div class="flex flex-wrap gap-2 mt-4 items-center text-xs text-slate-400">
        <span>Suggestions :</span>
        {termesFinanciers.map(terme => (
          <button 
            class="tag-btn px-3 py-1 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition cursor-pointer"
            data-term={terme}
          >
            {terme}
          </button>
        ))}
      </div>
    </div>

    {/* Message d'état / Loader */}
    <div id="dict-status" class="text-center text-slate-500 text-sm py-8">
      Entrez un mot-clé ou cliquez sur une suggestion pour afficher les définitions.
    </div>

    {/* Conteneur des cartes de définitions (une carte par source) */}
    <div id="dict-results-container" class="space-y-6 hidden">
      {/* Les cartes s'injecteront dynamiquement ici */}
    </div>

  </section>
</Layout>

<script>
  const searchInput = document.getElementById('dict-search-input') as HTMLInputElement;
  const searchBtn = document.getElementById('dict-search-btn');
  const resultsContainer = document.getElementById('dict-results-container');
  const statusDiv = document.getElementById('dict-status');
  const tagBtns = document.querySelectorAll('.tag-btn');

  // Source 1 : Wikipédia
  async function fetchWikipedia(term: string) {
    try {
      const res = await fetch(`https://fr.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(term)}`);
      if (!res.ok) return null;
      const data = await res.json();
      return {
        sourceName: 'Wikipédia',
        badgeClass: 'bg-blue-500/10 text-blue-400 border-blue-500/30',
        title: data.title,
        extract: data.extract,
        url: data.content_urls?.desktop?.page || `https://fr.wikipedia.org/wiki/${encodeURIComponent(term)}`
      };
    } catch {
      return null;
    }
  }

  // Source 2 : Wiktionnaire (via Dictionary API)
  async function fetchWiktionary(term: string) {
    try {
      const res = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/fr/${encodeURIComponent(term)}`);
      if (!res.ok) return null;
      const data = await res.json();
      const definition = data[0]?.meanings[0]?.definitions[0]?.definition;
      if (!definition) return null;

      return {
        sourceName: 'Wiktionnaire',
        badgeClass: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
        title: data[0].word,
        extract: definition,
        url: `https://fr.wiktionary.org/wiki/${encodeURIComponent(term)}`
      };
    } catch {
      return null;
    }
  }

  // Fonction globale de recherche multi-sources
  async function searchMultiSources(term: string) {
    if (!term.trim()) return;

    if (statusDiv) {
      statusDiv.textContent = "Recherche dans les différentes sources en cours...";
      statusDiv.classList.remove('hidden');
    }
    if (resultsContainer) {
      resultsContainer.classList.add('hidden');
      resultsContainer.innerHTML = '';
    }

    // Récupération en parallèle de toutes les sources
    const results = await Promise.all([
      fetchWikipedia(term),
      fetchWiktionary(term)
    ]);

    const validResults = results.filter(item => item !== null);

    if (validResults.length === 0) {
      if (statusDiv) {
        statusDiv.textContent = `Aucune définition trouvée pour "${term}" dans nos sources.`;
      }
      return;
    }

    // Création d'une carte distincte pour chaque source valide
    validResults.forEach(item => {
      if (!item) return;

      const card = document.createElement('div');
      card.className = "bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm shadow-xl transition hover:border-slate-600";

      card.innerHTML = `
        <div class="flex items-center justify-between mb-4 pb-4 border-b border-slate-700/50">
          <h2 class="text-2xl font-bold text-white">${item.title}</h2>
          <span class="text-xs px-3 py-1 rounded-full border font-semibold ${item.badgeClass}">
            Source : ${item.sourceName}
          </span>
        </div>
        <p class="text-slate-300 text-sm md:text-base leading-relaxed mb-6">
          ${item.extract}
        </p>
        <div class="flex justify-end">
          <a 
            href="${item.url}" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-xs font-semibold text-emerald-400 hover:underline inline-flex items-center gap-1"
          >
            Lire la suite sur ${item.sourceName} &rarr;
          </a>
        </div>
      `;

      resultsContainer?.appendChild(card);
    });

    if (statusDiv) statusDiv.classList.add('hidden');
    if (resultsContainer) resultsContainer.classList.remove('hidden');
  }

  // Événements
  searchBtn?.addEventListener('click', () => searchMultiSources(searchInput.value));
  searchInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') searchMultiSources(searchInput.value);
  });

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const term = btn.getAttribute('data-term') || '';
      searchInput.value = term;
      searchMultiSources(term);
    });
  });
</script>