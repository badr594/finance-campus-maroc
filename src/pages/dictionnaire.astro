---
import Layout from '../layouts/Layout.astro';
import dictionnaireData from '../data/dictionnaire.json';
---

<Layout title="Dictionnaire Financier - Club Finance ENCG Tanger">
  <section class="max-w-7xl mx-auto px-6 py-12">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Dictionnaire Financier & Économique
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Les Concepts Clés de la Finance
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed text-justify mb-8">
        Consultez notre sélection de 50 définitions clés ou recherchez n'importe quel terme économique et financier dans la base de connaissances globale en ligne.
      </p>

      {/* Barre de recherche dynamique */}
      <div class="relative max-w-xl mx-auto">
        <input
          type="text"
          id="dict-search-page"
          placeholder="Rechercher un terme (ex: WACC, Stagflation, Sukuk, FinTech)..."
          class="w-full px-5 py-3.5 bg-slate-900/80 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500/80 focus:ring-1 focus:ring-emerald-500/80 transition text-sm shadow-inner"
        />
      </div>
    </div>

    {/* Carte d'affichage des résultats externes (API Wikipédia) */}
    <div id="external-result" class="max-w-3xl mx-auto mb-10 hidden">
      <div class="p-6 bg-slate-800/80 border border-emerald-500/50 rounded-2xl shadow-xl">
        <div class="flex items-center justify-between mb-3">
          <span id="external-badge" class="px-3 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Source : Encyclopédie en ligne
          </span>
          <span id="external-loading" class="text-xs text-slate-400 hidden">Recherche en cours...</span>
        </div>
        <h3 id="external-title" class="text-xl font-bold text-white mb-2"></h3>
        <p id="external-def" class="text-slate-300 text-xs md:text-sm leading-relaxed text-justify mb-4"></p>
        <a id="external-link" href="#" target="_blank" rel="noopener noreferrer" class="text-xs text-emerald-400 hover:underline font-medium inline-block">
          Lire l'article complet
        </a>
      </div>
    </div>

    {/* Grille des 50 termes locaux */}
    <div id="full-dictionary-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {dictionnaireData.map((item) => (
        <div class="dict-page-card p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl hover:border-emerald-500/40 transition flex flex-col justify-between">
          <div>
            <h3 class="dict-page-title text-lg font-bold text-white mb-2">{item.terme}</h3>
            <p class="dict-page-def text-slate-300 text-xs leading-relaxed text-justify">{item.definition}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  const pageSearchInput = document.getElementById('dict-search-page') as HTMLInputElement;
  const pageCards = document.querySelectorAll('.dict-page-card');
  const externalResult = document.getElementById('external-result');
  const externalTitle = document.getElementById('external-title');
  const externalDef = document.getElementById('external-def');
  const externalLink = document.getElementById('external-link') as HTMLAnchorElement;
  const externalLoading = document.getElementById('external-loading');

  let debounceTimer: ReturnType<typeof setTimeout>;

  if (pageSearchInput) {
    pageSearchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      clearTimeout(debounceTimer);

      if (query.length < 2) {
        // Réinitialisation de l'affichage
        pageCards.forEach((card) => ((card as HTMLElement).style.display = 'flex'));
        externalResult?.classList.add('hidden');
        return;
      }

      // 1. Filtrage local parmi les 50 termes
      let hasLocalMatch = false;
      pageCards.forEach((card) => {
        const title = card.querySelector('.dict-page-title')?.textContent?.toLowerCase() || '';
        const def = card.querySelector('.dict-page-def')?.textContent?.toLowerCase() || '';

        if (title.includes(query) || def.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
          hasLocalMatch = true;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      // 2. Si aucun résultat local n'est trouvé, interrogation de l'API externe
      if (!hasLocalMatch) {
        externalLoading?.classList.remove('hidden');
        
        debounceTimer = setTimeout(async () => {
          try {
            const response = await fetch(
              `https://fr.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(query)}`
            );

            if (response.ok) {
              const data = await response.json();

              if (data.type === 'standard' && data.extract) {
                if (externalTitle) externalTitle.textContent = data.title;
                if (externalDef) externalDef.textContent = data.extract;
                if (externalLink) externalLink.href = data.content_urls.desktop.page;
                
                externalResult?.classList.remove('hidden');
              } else {
                externalResult?.classList.add('hidden');
              }
            } else {
              externalResult?.classList.add('hidden');
            }
          } catch (err) {
            externalResult?.classList.add('hidden');
          } finally {
            externalLoading?.classList.add('hidden');
          }
        }, 400);
      } else {
        externalResult?.classList.add('hidden');
      }
    });
  }
</script>