---
import Layout from '../layouts/Layout.astro';

const termesFinanciers = [
  "Action",
  "Obligation",
  "OPCVM",
  "Bourse",
  "Inflation",
  "Portefeuille"
];
---

<Layout title="Dictionnaire Multi-Sources - Club Finance">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    {/* En-tête */}
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Recherche Multi-Sources
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mb-4">
        Dictionnaire Financier
      </h1>
      <p class="text-slate-400 text-sm">
        Recherchez un terme pour obtenir simultanément ses définitions depuis plusieurs sources.
      </p>
    </div>

    {/* Barre de recherche */}
    <div class="mb-8">
      <div class="flex gap-3">
        <input 
          type="text" 
          id="dict-search-input" 
          placeholder="Ex: Action, Obligation, Inflation..." 
          class="w-full px-5 py-3.5 rounded-xl bg-slate-900/80 border border-slate-700 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-emerald-500 transition"
        />
        <button 
          id="dict-search-btn"
          class="px-6 py-3.5 rounded-xl bg-emerald-500 text-slate-950 font-bold text-sm hover:bg-emerald-400 transition cursor-pointer"
        >
          Chercher
        </button>
      </div>
      
      {/* Suggestions rapides */}
      <div class="flex flex-wrap gap-2 mt-4 items-center text-xs text-slate-400">
        <span>Suggestions :</span>
        {termesFinanciers.map(terme => (
          <button 
            class="tag-btn px-3 py-1 rounded-lg bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition cursor-pointer"
            data-term={terme}
          >
            {terme}
          </button>
        ))}
      </div>
    </div>

    {/* Indication / Loader */}
    <div id="dict-status" class="text-center text-slate-500 text-sm py-8">
      Entrez un mot-clé ou cliquez sur une suggestion pour afficher les définitions multi-sources.
    </div>

    {/* Conteneur des définitions multi-sources */}
    <div id="dict-results-container" class="space-y-6 hidden">
      {/* Les blocs de chaque source s'injecteront ici dynamiquement */}
    </div>

  </section>
</Layout>

<script>
  const searchInput = document.getElementById('dict-search-input') as HTMLInputElement;
  const searchBtn = document.getElementById('dict-search-btn');
  const resultsContainer = document.getElementById('dict-results-container');
  const statusDiv = document.getElementById('dict-status');
  const tagBtns = document.querySelectorAll('.tag-btn');

  // 1. Source Wikipédia
  async function fetchWikipedia(term: string) {
    try {
      const res = await fetch(`https://fr.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(term)}`);
      if (!res.ok) return null;
      const data = await res.json();
      return {
        source: 'Wikipédia',
        badgeColor: 'bg-blue-500/10 text-blue-400 border-blue-500/30',
        title: data.title,
        text: data.extract,
        link: data.content_urls?.desktop?.page || `https://fr.wikipedia.org/wiki/${encodeURIComponent(term)}`
      };
    } catch {
      return null;
    }
  }

  // 2. Source Wiktionnaire (via Dictionnaire API)
  async function fetchWiktionary(term: string) {
    try {
      const res = await fetch(`https://api.dictionaryapi.dev/api/v2/entries/fr/${encodeURIComponent(term)}`);
      if (!res.ok) return null;
      const data = await res.json();
      const firstMeaning = data[0]?.meanings[0]?.definitions[0]?.definition;
      if (!firstMeaning) return null;
      
      return {
        source: 'Wiktionnaire (Dictionnaire)',
        badgeColor: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
        title: data[0].word,
        text: firstMeaning,
        link: `https://fr.wiktionary.org/wiki/${encodeURIComponent(term)}`
      };
    } catch {
      return null;
    }
  }

  // Fonction principale de recherche multi-sources
  async function searchAllSources(term: string) {
    if (!term.trim()) return;

    if (statusDiv) {
      statusDiv.textContent = "Recherche dans les différentes sources...";
      statusDiv.classList.remove('hidden');
    }
    if (resultsContainer) {
      resultsContainer.classList.add('hidden');
      resultsContainer.innerHTML = '';
    }

    // Appel simultané de toutes les sources
    const results = await Promise.all([
      fetchWikipedia(term),
      fetchWiktionary(term)
    ]);

    // Filtrer les sources qui ont renvoyé un résultat
    const validResults = results.filter(res => res !== null);

    if (validResults.length === 0) {
      if (statusDiv) {
        statusDiv.textContent = `Aucune définition trouvée pour "${term}". Essayez un autre mot-clé.`;
      }
      return;
    }

    // Générer les cartes pour chaque source
    validResults.forEach(item => {
      if (!item) return;

      const card = document.createElement('div');
      card.className = "bg-slate-800/40 border border-slate-700/60 rounded-3xl p-6 backdrop-blur-sm shadow-xl transition hover:border-slate-600";

      card.innerHTML = `
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-700/50">
          <h2 class="text-xl font-bold text-white">${item.title}</h2>
          <span class="text-xs px-3 py-1 rounded-full border font-semibold ${item.badgeColor}">
            Source : ${item.source}
          </span>
        </div>
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          ${item.text}
        </p>
        <div class="flex justify-end">
          <a href="${item.link}" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-emerald-400 hover:underline inline-flex items-center gap-1">
            Voir la source sur ${item.source} &rarr;
          </a>
        </div>
      `;

      resultsContainer?.appendChild(card);
    });

    if (statusDiv) statusDiv.classList.add('hidden');
    if (resultsContainer) resultsContainer.classList.remove('hidden');
  }

  // Événements
  searchBtn?.addEventListener('click', () => searchAllSources(searchInput.value));
  searchInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') searchAllSources(searchInput.value);
  });

  tagBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const term = btn.getAttribute('data-term') || '';
      searchInput.value = term;
      searchAllSources(term);
    });
  });
</script>