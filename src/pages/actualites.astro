---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Actualités Financières - Finance Campus Maroc">
  <section class="max-w-7xl mx-auto px-6 py-12">
    
    {/* En-tête de la page */}
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Fil d'Actualités Live
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Actualités Financières en Direct
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed">
        Suivez en temps réel l'ensemble de l'actualité économique, financière et boursière au Maroc et à l'échelle internationale.
      </p>
    </div>

    {/* GRILLE DIVISÉE EN 2 : MAROC & INTERNATIONAL */}
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      {/* 1. ACTUALITÉS MAROC */}
      <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 shadow-2xl flex flex-col h-[680px]">
        <div class="mb-6 pb-4 border-b border-slate-800">
          <h2 class="text-lg font-bold text-white uppercase tracking-wider">Maroc : Économie, Finance & Bourse</h2>
          <p class="text-xs text-slate-400 mt-1">Dernières publications des médias financiers nationaux</p>
        </div>

        <div id="maroc-news-feed" class="flex-1 overflow-y-auto space-y-4 pr-2 custom-scrollbar">
          <div class="text-center text-slate-400 text-xs py-12">Chargement des actualités du Maroc...</div>
        </div>
      </div>

      {/* 2. ACTUALITÉS INTERNATIONALES */}
      <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 shadow-2xl flex flex-col h-[680px]">
        <div class="mb-6 pb-4 border-b border-slate-800">
          <h2 class="text-lg font-bold text-white uppercase tracking-wider">Actualités Internationales</h2>
          <p class="text-xs text-slate-400 mt-1">Économie mondiale, marchés boursiers globaux et devises</p>
        </div>

        <div id="intl-news-feed" class="flex-1 overflow-y-auto space-y-4 pr-2 custom-scrollbar">
          <div class="text-center text-slate-400 text-xs py-12">Chargement des actualités internationales...</div>
        </div>
      </div>

    </div>

  </section>
</Layout>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(15, 23, 42, 0.6);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(51, 65, 85, 0.8);
    border-radius: 9999px;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', async () => {
    
    // Fonction utilitaire pour charger un flux RSS dans un conteneur donné
    async function loadRSSFeed(feedUrl, containerId, categoryName) {
      const container = document.getElementById(containerId);
      if (!container) return;

      try {
        const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feedUrl)}`;
        const response = await fetch(apiUrl);
        const data = await response.json();

        if (data.status === 'ok' && data.items && data.items.length > 0) {
          container.innerHTML = '';
          data.items.slice(0, 15).forEach((item) => {
            const date = item.pubDate ? new Date(item.pubDate).toLocaleDateString('fr-FR', {
              day: 'numeric',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit'
            }) : '';

            const cleanDescription = item.description 
              ? item.description.replace(/<[^>]*>?/gm, '').trim() 
              : '';

            const article = document.createElement('a');
            article.href = item.link;
            article.target = '_blank';
            article.rel = 'noopener noreferrer';
            article.className = 'block p-4 rounded-2xl bg-slate-800/40 border border-slate-700/50 hover:border-emerald-500/40 hover:bg-slate-800/80 transition group';

            article.innerHTML = `
              <div class="flex items-center justify-between text-[11px] text-emerald-400 mb-1.5 font-semibold">
                <span>${categoryName}</span>
                <span class="text-slate-500 font-normal">${date}</span>
              </div>
              <h3 class="text-sm font-bold text-white group-hover:text-emerald-300 transition line-clamp-2 leading-snug mb-1">
                ${item.title}
              </h3>
              ${cleanDescription ? `<p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">${cleanDescription}</p>` : ''}
            `;
            container.appendChild(article);
          });
        } else {
          container.innerHTML = '<div class="text-slate-400 text-xs text-center py-12">Aucune actualité disponible pour le moment.</div>';
        }
      } catch (e) {
        container.innerHTML = '<div class="text-slate-400 text-xs text-center py-12">Erreur de chargement du flux d\'actualités.</div>';
      }
    }

    // 1. Chargement du flux Maroc
    loadRSSFeed('https://lematin.ma/rssFeed/4', 'maroc-news-feed', 'Économie Maroc');

    // 2. Chargement du flux International (Investing / Actualités Mondiales)
    loadRSSFeed('https://fr.investing.com/rss/news_25.rss', 'intl-news-feed', 'Économie Internationale');
  });
</script>