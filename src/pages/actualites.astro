---
import Layout from '../layouts/Layout.astro';

const articles = [
  {
    id: 1,
    title: "Bourse de Casablanca : Tendances et perspectives du MASI",
    category: "Marchés Financiers",
    date: "1 Nov 2026",
    readTime: "5 min de lecture",
    summary: "Analyse approfondie de la performance de l'indice phare marocain et des valeurs bancaires et immobilières qui soutiennent la tendance.",
    tagColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
  },
  {
    id: 2,
    title: "Taux Directeurs & Politique Monétaire : Décision de Bank Al-Maghrib",
    category: "Macroéconomie",
    date: "28 Oct 2026",
    readTime: "4 min de lecture",
    summary: "Décryptage des décisions de la banque centrale marocaine face à l'évolution de l'inflation et des prévisions de croissance.",
    tagColor: "bg-blue-500/10 text-blue-400 border-blue-500/20"
  },
  {
    id: 3,
    title: "Les Obligations Vertes (Green Bonds) en Afrique du Nord",
    category: "Finance Durable",
    date: "20 Oct 2026",
    readTime: "6 min de lecture",
    summary: "Comment les émissions obligataires durables transforment le financement des projets d'énergies renouvelables et d'infrastructures.",
    tagColor: "bg-teal-500/10 text-teal-400 border-teal-500/20"
  },
  {
    id: 4,
    title: "Introduction aux FinTechs et au crowdfunding au Maroc",
    category: "Innovation",
    date: "15 Oct 2026",
    readTime: "7 min de lecture",
    summary: "Un aperçu du cadre réglementaire et des opportunités offertes par le financement participatif pour les startups marocaines.",
    tagColor: "bg-purple-500/10 text-purple-400 border-purple-500/20"
  }
];
---

<Layout title="Actualités & Analyses - Finance Campus Maroc">
  <main class="max-w-7xl mx-auto px-6 py-16">
    {/* En-tête de la page */}
    <div class="mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-4">
        Économie & Marchés
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        Actualités & <span class="text-emerald-500">Analyses Financières</span>
      </h1>
      <p class="text-slate-400 text-base max-w-2xl">
        Retrouvez les décryptages économiques, l'actualité des marchés financiers et les publications rédigées par le Club Finance ENCG Tanger.
      </p>
    </div>

    {/* Grille d'articles */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {articles.map((item) => (
        <article class="bg-slate-800/40 border border-slate-700/60 rounded-2xl p-8 hover:border-emerald-500/50 transition duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class={`px-3 py-1 rounded-full text-xs font-medium border ${item.tagColor}`}>
                {item.category}
              </span>
              <div class="flex items-center gap-3 text-xs text-slate-500">
                <span>{item.date}</span>
                <span>•</span>
                <span>{item.readTime}</span>
              </div>
            </div>
            
            <h2 class="text-xl font-bold text-white mb-3 hover:text-emerald-400 transition cursor-pointer">
              {item.title}
            </h2>
            
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              {item.summary}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-700/40 flex justify-between items-center text-xs">
            <span class="text-slate-400 font-medium">Club Finance ENCGT</span>
            <button class="text-emerald-400 font-semibold hover:underline flex items-center gap-1">
              Lire l'article complet &rarr;
            </button>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>