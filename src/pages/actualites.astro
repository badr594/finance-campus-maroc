---
import Layout from '../layouts/Layout.astro';

const articlesMaroc = [
  {
    title: "Bourse de Casablanca : Tendances et perspectives du MASI",
    category: "Finance Nationale",
    date: "1 Nov 2026",
    readTime: "5 min de lecture",
    summary: "Analyse approfondie de la performance du marché boursier marocain, tirée par le secteur bancaire et les infrastructures.",
    tagColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
  },
  {
    title: "Taux Directeurs & Politique Monétaire : Décisions de Bank Al-Maghrib",
    category: "Macroéconomie Maroc",
    date: "28 Oct 2026",
    readTime: "4 min de lecture",
    summary: "Décryptage des orientations de la banque centrale marocaine face à la maîtrise de l'inflation et la relance du crédit.",
    tagColor: "bg-teal-500/10 text-teal-400 border-teal-500/20"
  },
  {
    title: "Développement du Crowdfunding et des FinTechs au Maroc",
    category: "Innovation & Réglementation",
    date: "15 Oct 2026",
    readTime: "6 min de lecture",
    summary: "Vue d'ensemble sur le déploiement du cadre réglementaire du financement participatif et son impact sur les PME marocaines.",
    tagColor: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20"
  }
];

const articlesInternational = [
  {
    title: "Politique Monétaire des Banques Centrales (Fed & BCE)",
    category: "Marchés Verticaux",
    date: "30 Oct 2026",
    readTime: "5 min de lecture",
    summary: "Analyse comparative des ajustements de taux d'intérêt aux États-Unis et en Europe et leurs répercussions sur les marchés émergents.",
    tagColor: "bg-blue-500/10 text-blue-400 border-blue-500/20"
  },
  {
    title: "Les Mégatendances des Obligations Vertes à l'Échelle Mondiale",
    category: "Finance Durable",
    date: "22 Oct 2026",
    readTime: "7 min de lecture",
    summary: "Comment les critères ESG et les émission de Green Bonds façonnent les stratégies d'investissement institutionnel mondial.",
    tagColor: "bg-indigo-500/10 text-indigo-400 border-indigo-500/20"
  },
  {
    title: "Matières Premières & Cours de l'Or sur les Marchés Internationaux",
    category: "Commodities",
    date: "18 Oct 2026",
    readTime: "4 min de lecture",
    summary: "Étude de la volatilité des cours des matières premières et des stratégies de couverture (hedging) adoptées par les multinationales.",
    tagColor: "bg-purple-500/10 text-purple-400 border-purple-500/20"
  }
];
---

<Layout title="Actualités & Analyses - Finance Campus Maroc">
  <main class="max-w-7xl mx-auto px-6 py-16">
    {/* En-tête */}
    <div class="mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-4">
        Économie & Marchés
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        Actualités & <span class="text-emerald-500">Analyses Financières</span>
      </h1>
      <p class="text-slate-400 text-base max-w-2xl">
        Suivez au quotidien l'actualité financière du Maroc et les grandes tendances des marchés internationaux.
      </p>
    </div>

    {/* Section 1 : Actualité Financière au Maroc */}
    <section class="mb-16">
      <div class="flex items-center gap-3 mb-8 border-b border-slate-800 pb-4">
        <span class="text-2xl">🇲🇦</span>
        <h2 class="text-2xl font-bold text-white">Actualités du Maroc</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articlesMaroc.map((item) => (
          <article class="bg-slate-800/40 border border-slate-700/60 rounded-2xl p-6 hover:border-emerald-500/50 transition duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class={`px-2.5 py-1 rounded-full text-[11px] font-medium border ${item.tagColor}`}>
                  {item.category}
                </span>
                <span class="text-xs text-slate-500">{item.date}</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-3 hover:text-emerald-400 transition cursor-pointer">
                {item.title}
              </h3>
              <p class="text-slate-400 text-xs leading-relaxed mb-6">
                {item.summary}
              </p>
            </div>
            <div class="pt-4 border-t border-slate-700/40 flex justify-between items-center text-xs">
              <span class="text-slate-500">{item.readTime}</span>
              <button class="text-emerald-400 font-semibold hover:underline">
                Lire la suite &rarr;
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Section 2 : Finance Internationale */}
    <section>
      <div class="flex items-center gap-3 mb-8 border-b border-slate-800 pb-4">
        <span class="text-2xl">🌐</span>
        <h2 class="text-2xl font-bold text-white">Finance Internationale</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {articlesInternational.map((item) => (
          <article class="bg-slate-800/40 border border-slate-700/60 rounded-2xl p-6 hover:border-blue-500/50 transition duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class={`px-2.5 py-1 rounded-full text-[11px] font-medium border ${item.tagColor}`}>
                  {item.category}
                </span>
                <span class="text-xs text-slate-500">{item.date}</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-3 hover:text-blue-400 transition cursor-pointer">
                {item.title}
              </h3>
              <p class="text-slate-400 text-xs leading-relaxed mb-6">
                {item.summary}
              </p>
            </div>
            <div class="pt-4 border-t border-slate-700/40 flex justify-between items-center text-xs">
              <span class="text-slate-500">{item.readTime}</span>
              <button class="text-blue-400 font-semibold hover:underline">
                Lire la suite &rarr;
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>