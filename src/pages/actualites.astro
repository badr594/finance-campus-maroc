---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Actualités Financières en Direct - Finance Campus Maroc">
  <section class="max-w-7xl mx-auto px-6 py-12">
    
    {/* En-tête de la page */}
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Fil d'Actualités Live
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Actualités Financières en Direct
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed">
        Suivez en temps réel les dernières informations économiques, les marchés boursiers et les tendances financières mondiales.
      </p>
    </div>

    {/* Conteneur du Widget TradingView */}
    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-4 md:p-6 shadow-2xl min-h-[650px]">
      <div id="tradingview-news-container" class="w-full h-[650px]"></div>
    </div>

  </section>
</Layout>

<script is:inline>
  // Injection dynamique du script TradingView au chargement
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('tradingview-news-container');
    if (container) {
      container.innerHTML = ''; // Nettoyage
      const script = document.createElement('script');
      script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-timeline.js';
      script.async = true;
      script.type = 'text/javascript';
      script.innerHTML = JSON.stringify({
        "feedMode": "all_symbols",
        "isTransparent": true,
        "displayMode": "regular",
        "width": "100%",
        "height": "650",
        "colorTheme": "dark",
        "locale": "fr"
      });
      container.appendChild(script);
    }
  });
</script>