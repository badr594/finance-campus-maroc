  const k1=x.k1(o),k2=x.k2(o);
  sd+=`<div class="stat"><small>${k1[0]}</small><b class="nat">${k1[1]}</b><small>${k1[2]}</small></div><div class="stat"><small>${k2[0]}</small><b class="perso">${k2[1]}</b><small>${k2[2]}</small></div>`;
  $("stats").innerHTML=sd;
  $("hero").innerHTML=x.hero(o);
  // tableau des valeurs
  let cd=`<tr><th>${x.cd[0]}</th><th class="num">${x.cd[1]}</th><th class="num">${x.cd[2]}</th></tr>`;
  const idx=[];for(let i=i0;i<=i1;i+=Math.max(1,Math.ceil((i1-i0)/12)))idx.push(i); if(idx[idx.length-1]!==i1)idx.push(i1);
  const anchor=nat[i0]/P[i0];
  idx.forEach(i=>cd+=`<tr><td>${lbl(i)}</td><td class="num">${fmt(nat[i],1)}</td><td class="num">${fmt(P[i]*anchor,1)}</td></tr>`);
  $("chartdata").innerHTML=cd;
  // répartition
  const rows=CODES.map(c=>({c,brut:S[c][i1]/S[c][i0]-1,you:contribI(cp.items,Pc,q=>q.c===c,i0,i1),avg:contrib(WEXACT,PA,c,i0,i1)})).sort((a,b)=>b.you-a.you);
  const vals=rows.flatMap(r=>[r.you*100,r.avg*100]), mn=Math.min(0,...vals), mx=Math.max(0.01,...vals);
  const Wd=800,L=190,R=40,rh=36, xs=v=>L+(v-mn)/(mx-mn||1)*(Wd-L-R); let g=`<line x1="${xs(0)}" x2="${xs(0)}" y1="6" y2="${rows.length*rh+6}" stroke="#8a93a6"/>`;
  rows.forEach((r,k)=>{const y=10+k*rh;
    g+=`<text x="${L-8}" y="${y+18}" text-anchor="end" font-size="12.5">${nm(r.c)}</text>`;
    const bar=(v,off,col)=>{const x0=xs(0),x1=xs(v);return `<rect x="${Math.min(x0,x1)}" y="${y+off}" width="${Math.abs(x1-x0)||1}" height="12" fill="${col}"/><text x="${x1+(v>=0?4:-4)}" y="${y+off+10}" font-size="11" text-anchor="${v>=0?"start":"end"}" fill="#566072">${nf(v,1)}</text>`};
    g+=bar(r.you*100,2,"#b93a09")+bar(r.avg*100,17,"#0b5d3b");});
  $("bars").setAttribute("viewBox",`0 0 ${Wd} ${rows.length*rh+16}`);$("bars").innerHTML=g;
  $("bars").setAttribute("aria-label",x.reph[0]+" / "+x.reph[2]);
  const RH=x.reph;
  let t=`<tr><th>${RH[0]}</th><th class='num'>${RH[1]}</th><th class='num'>${RH[2]}</th><th class='num'>${RH[3]}</th></tr>`;
  rows.forEach(r=>t+=`<tr><td>${nm(r.c)}</td><td class="num">${pct(r.brut)}</td><td class="num perso">${fmt(r.you*100,2)}</td><td class="num nat">${fmt(r.avg*100,2)}</td></tr>`);
