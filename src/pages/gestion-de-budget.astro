},
ar:{
 stats:(o)=>[["ارتفاع الأسعار، السلة المتوسطة",pct(o.rN-1),"nat"],["ارتفاع الأسعار، سلتكم",pct(o.rP-1),"perso"],
  ["الوتيرة السنوية المتوسطة، السلة المتوسطة",o.yr?pct(o.aN):"—","nat"],["الوتيرة السنوية المتوسطة، أنتم",o.yr?pct(o.aP):"—","perso"],
  [`12 شهرا إلى غاية ${o.p1}، السلة المتوسطة`,o.has12?pct(o.l12N):"—","nat"],[`12 شهرا إلى غاية ${o.p1}، أنتم`,o.has12?pct(o.l12P):"—","perso"]],
 k1:(o)=>[`1 000 درهم في ${o.p0} تعادل…`,mad(1000*o.rN),`في ${o.p1}، السلة المتوسطة`],
 k2:(o)=>[`1 000 درهم في ${o.p0} تعادل…`,mad(1000*o.rP),`في ${o.p1}، سلتكم`],
 hero:(o)=>{
  let h=`<p>بين <b>${o.p0}</b> و<b>${o.p1}</b>، تغيرت أسعار سلتكم بنسبة <b class="perso">${pct(o.rP-1)}</b>، مقابل <b class="nat">${pct(o.rN-1)}</b> للسلة المتوسطة.</p>`;
  const d=(o.rP-o.rN)*100;
  h+=`<p>${Math.abs(d)<0.5?"تضخمكم قريب من المتوسط.":`تضخمكم ${d>0?"أعلى من":"أدنى من"} المتوسط بـ <b>${fmt(Math.abs(d),1)} نقطة</b>.`}</p>`;
  if(o.has12) h+=`<p>خلال 12 شهرا إلى غاية ${o.p1}: <b class="perso">${pct(o.l12P)}</b> بالنسبة لكم، و<b class="nat">${pct(o.l12N)}</b> للسلة المتوسطة.</p>`;
  const x=o.tot-o.tot/o.rP;
  h+=`<p class="note">إذا كانت المبالغ المدخلة هي مبالغ ${o.p1} (${mad(o.tot)} في الشهر)، فإن السلة نفسها كانت ستكلف ${mad(o.tot/o.rP)} في ${o.p0}: أي <b>${mad(Math.abs(x))}</b> ${x>=0?"أكثر":"أقل"} في الشهر اليوم.</p>`;
  return h},
 chartLabel:"تطور الرقم الاستدلالي لسلتكم والرقم الاستدلالي الوطني",
 tip:(l,a,b)=>`<b>${l}</b><br>الرسمي: ${a}<br>سلتكم: ${b}`,
 chartnote:(o)=>`نهاية الفترة (${o.p1}): الرقم الرسمي ${fmt(o.nv,1)}، وسلتكم ${fmt(o.pv,1)} بعد تثبيتها على الرقم الرسمي لشهر ${o.p0}. الفارق: ${fmt(o.pv-o.nv,2)} نقطة.`,
 cd:["الشهر","الرسمي","سلتكم"],
 reph:["المجموعة","ارتفاع المجموعة","المساهمة، أنتم (نقطة)","المساهمة، السلة المتوسطة (نقطة)"],total:"المجموع",
