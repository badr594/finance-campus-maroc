const X=()=>I[lang];

// ================= Moteur =================
function personal(w){
  const s=CODES.reduce((a,c)=>a+w[c],0), P=new Array(N);
  for(let i=0;i<N;i++){let a=0;for(const c of CODES) a+=w[c]/s*S[c][i];P[i]=a}
  return P;
}
function contrib(w,P,c,i0,i1){
  const s=CODES.reduce((a,k)=>a+w[k],0);
  return (w[c]/s)*(S[c][i1]-S[c][i0])/P[i0];
}

// ================= État =================
const state={vals:{},disp:{},sub:{},open:{},i0:FIRST,i1:LAST,preset:"ipc",wizDone:false};
const subAmt=k=>{const v=parseFloat(state.sub[k]);return isFinite(v)&&v>0?v:0};
const anySub=()=>SUB.some(j=>subAmt(j.k)>0);
const sname=j=>lang==="ar"?j.ar:j.fr;
CODES.forEach(c=>{state.vals[c]=null;state.disp[c]={v:"",u:"m"}});
const toMonth=(v,u)=>u==="a"?v/12:u==="w"?v*52/12:v;
function setField(c,v,u="m"){ // v : nombre ou null
  state.disp[c]={v:v==null?"":String(v),u};
  state.vals[c]=v==null?null:toMonth(v,u);
  const el=$("v"+c); if(el){el.value=state.disp[c].v;const s=document.querySelector(`select[data-u="${c}"]`);if(s)s.value=u}
}
function weights(){
  if(!anySub()&&CODES.every(c=>state.vals[c]==null||isNaN(state.vals[c]))) return {...WEXACT};
  const w={};CODES.forEach(c=>{const v=state.vals[c];w[c]=(v==null||isNaN(v))?AVG[c]:v});return w}
let store=null;
try{store=window.localStorage;store.getItem("x")}catch(e){store=null}
function save(){try{if(store)store.setItem("ipcma",JSON.stringify({lang,disp:state.disp,sub:state.sub,preset:state.preset,wiz:state.wizDone}))}catch(e){}}
function load(){try{if(!store)return;const s=JSON.parse(store.getItem("ipcma")||"null");if(!s)return;
  if(s.lang==="ar"||s.lang==="fr")lang=s.lang;
  if(s.disp)CODES.forEach(c=>{const d=s.disp[c];if(d&&typeof d.v==="string"&&["m","w","a"].includes(d.u)){const v=d.v===""?null:parseFloat(d.v);if(v==null||(isFinite(v)&&v>=0)){state.disp[c]={v:d.v,u:d.u};state.vals[c]=v==null?null:toMonth(v,d.u)}}});
  if(s.sub&&typeof s.sub==="object")SUB.forEach(j=>{const v=parseFloat(s.sub[j.k]);if(isFinite(v)&&v>0)state.sub[j.k]=String(v)});
  if(["ipc","e22","e14","perso"].includes(s.preset))state.preset=s.preset;state.wizDone=!!s.wiz}catch(e){}}

// composantes : postes détaillés + reste de chaque division
function comps(){
  const base=weights(), items=[], tot={};
  CODES.forEach(c=>{
    const subs=SUBBY[c].filter(j=>subAmt(j.k)>0), sum=subs.reduce((a,j)=>a+subAmt(j.k),0), T=Math.max(base[c],sum);
    tot[c]=T; subs.forEach(j=>items.push({c,k:j.k,w:subAmt(j.k),s:SS[j.k]}));
    if(T-sum>1e-9) items.push({c,k:null,w:T-sum,s:S[c]});
  });
  return {tot,items,base};
}
const personalI=items=>{const s=items.reduce((a,x)=>a+x.w,0),P=new Array(N);for(let i=0;i<N;i++){let a=0;for(const x of items)a+=x.w*x.s[i];P[i]=a/s}return P};
const contribI=(items,P,pick,i0,i1)=>{const s=items.reduce((a,x)=>a+x.w,0);return items.filter(pick).reduce((a,x)=>a+x.w/s*(x.s[i1]-x.s[i0]),0)/P[i0]};

// ================= Saisie =================
function buildBasket(){
  const x=X(), H=x.bh;
  let h=`<tr><th>${H[0]}</th><th class='num hide-s'>${H[1]}</th><th>${H[2]}</th><th>${H[3]}</th></tr>`;
  for(const c of CODES) h+=`<tr><td title="${lg(c)}">${nm(c)}<small>${hn(c)}</small><button type="button" class="btn tgl" data-t="${c}" aria-expanded="${!!state.open[c]}" aria-controls="sr${c}"></button></td><td class="num hide-s">${mad(AVG[c])}</td><td><input type="number" inputmode="decimal" min="0" step="1" id="v${c}" data-c="${c}" placeholder="${AVG[c]}" value="${state.disp[c].v}" aria-label="${x.aria(c)}"></td><td><select data-u="${c}" aria-label="${x.ariaU(c)}"><option value="m">${x.units.m}</option><option value="w">${x.units.w}</option><option value="a">${x.units.a}</option></select></td></tr>
  <tr class="subrow" id="sr${c}" ${state.open[c]?"":"hidden"}><td colspan="4"><p class="note" style="margin:4px 0">${x.subP}</p><div class="subgrid">${SUBBY[c].map(j=>`<label class="field"><span>${sname(j)}</span><input type="number" inputmode="decimal" min="0" step="1" data-sk="${j.k}" value="${state.sub[j.k]||""}" placeholder="0"></label>`).join("")}</div><p class="note" id="sn${c}" aria-live="polite"></p></td></tr>`;
  $("basket").innerHTML=h;
  document.querySelectorAll("input[data-sk]").forEach(el=>el.addEventListener("input",()=>{state.sub[el.dataset.sk]=el.value;refresh()}));
  document.querySelectorAll("button[data-t]").forEach(b=>b.onclick=()=>{const c=b.dataset.t;state.open[c]=!state.open[c];$("sr"+c).hidden=!state.open[c];b.setAttribute("aria-expanded",!!state.open[c]);updateSubUI()});
  CODES.forEach(c=>document.querySelector(`select[data-u="${c}"]`).value=state.disp[c].u);
  const read=c=>{const el=$("v"+c),u=document.querySelector(`select[data-u="${c}"]`).value;
    const v=el.value===""?null:parseFloat(el.value);const ok=v!=null&&isFinite(v)&&v>=0;
    state.disp[c]={v:el.value,u};state.vals[c]=ok?toMonth(v,u):null};
  document.querySelectorAll("input[data-c]").forEach(el=>el.addEventListener("input",()=>{read(el.dataset.c);state.preset=$("preset").value==="perso"?"perso":state.preset;refresh()}));
  document.querySelectorAll("select[data-u]").forEach(el=>el.addEventListener("change",()=>{read(el.dataset.u);refresh()}));
}
$("reset").onclick=()=>{state.sub={};state.open={};buildBasket();CODES.forEach(c=>setField(c,null,"m"));state.preset="ipc";$("preset").value="ipc";state.wizDone=false;$("optperso").disabled=true;state.i0=FIRST;state.i1=LAST;wz.a={};sync();refresh();if(wzRendered)renderWiz()};
$("preset").onchange=e=>{
  const p=e.target.value; state.preset=p;
  if(p==="perso"){refresh();return}
  state.sub={};buildBasket();
  CODES.forEach(c=>{ if(p==="ipc") setField(c,null,"m"); else setField(c,Math.round(PRESETS[p][c]/100*TOTAL),"m") });
  refresh();
};

// ================= Période =================
function sync(){const a=$("s0"),b=$("s1");a.min=b.min=FIRST;a.max=b.max=LAST;a.value=state.i0;b.value=state.i1;$("s0v").textContent=lbl(state.i0);$("s1v").textContent=lbl(state.i1);
  a.setAttribute("aria-valuetext",lbl(state.i0));b.setAttribute("aria-valuetext",lbl(state.i1))}
$("s0").oninput=e=>{state.i0=Math.min(+e.target.value,state.i1-1);sync();refresh()};
$("s1").oninput=e=>{state.i1=Math.max(+e.target.value,state.i0+1);sync();refresh()};
document.querySelectorAll("[data-pre]").forEach(b=>b.onclick=()=>{const p=b.dataset.pre;state.i1=LAST;state.i0=p==="all"?FIRST:Math.max(FIRST,LAST-(+p));sync();refresh()});

// ================= Graphique =================
function niceScale(lo,hi){
  const raw=Math.max(hi-lo,0.5), cands=[0.5,1,2,5,10,20,50];
  let step=cands.find(s=>raw/s<=6)||50;
  let mn=Math.floor(lo/step)*step, mx=Math.ceil(hi/step)*step; if(mx===mn) mx+=step;
  return {mn,mx,step};
}
function drawChart(nat,per,i0,i1){
  const W=800,H=360,L=48,R=14,Tt=12,B=28, xs=i=>L+(i-i0)/(i1-i0)*(W-L-R);
  const anchor=nat[i0]/per[i0];
  const pv=[],nv=[]; for(let i=i0;i<=i1;i++){pv.push(per[i]*anchor);nv.push(nat[i])}
  const all=pv.concat(nv), {mn,mx,step}=niceScale(Math.min(...all),Math.max(...all)), ys=v=>Tt+(1-(v-mn)/(mx-mn))*(H-Tt-B);
  let g="";
  for(let v=mn;v<=mx+1e-9;v+=step) g+=`<line x1="${L}" x2="${W-R}" y1="${ys(v)}" y2="${ys(v)}" stroke="#e5e8e2"/><text x="${L-6}" y="${ys(v)+4}" text-anchor="end" font-size="11" fill="#566072">${nf(v,step<1?1:0)}</text>`;
  const span=i1-i0;
  if(span<=30){ const q=span<=14?1:3; for(let i=i0;i<=i1;i+=q) g+=`<text x="${xs(i)}" y="${H-8}" text-anchor="middle" font-size="11" fill="#566072">${MONTHS[lang][i%12].slice(0,5)} ${String(2017+Math.floor(i/12)).slice(2)}</text>`; }
  else { for(let y=2017;y<=2026;y++){ const i=(y-2017)*12; if(i<i0||i>i1) continue; g+=`<text x="${xs(i)}" y="${H-8}" text-anchor="middle" font-size="11" fill="#566072">${y}</text>`} }
  const path=arr=>arr.map((v,k)=>(k?"L":"M")+xs(i0+k).toFixed(1)+" "+ys(v).toFixed(1)).join(" ");
  g+=`<path d="${path(nv)}" fill="none" stroke="#0b5d3b" stroke-width="2.2"/><path d="${path(pv)}" fill="none" stroke="#b93a09" stroke-width="2.2" stroke-dasharray="7 3"/>`;
  g+=`<line id="cur" x1="0" x2="0" y1="${Tt}" y2="${H-B}" stroke="#8a93a6" stroke-dasharray="3 3" style="display:none"/>`;
  $("chart").innerHTML=g;
  const svg=$("chart"),tip=$("tip"),wrap=$("chartwrap");
  svg.setAttribute("aria-label",X().chartLabel);
  svg.onpointermove=e=>{const r=svg.getBoundingClientRect();const x=(e.clientX-r.left)/r.width*W;let k=Math.round((x-L)/(W-L-R)*(i1-i0));k=Math.max(0,Math.min(i1-i0,k));const cur=$("cur");cur.setAttribute("x1",xs(i0+k));cur.setAttribute("x2",xs(i0+k));cur.style.display="";tip.style.display="block";tip.innerHTML=X().tip(lbl(i0+k),fmt(nv[k],2),fmt(pv[k],2));tip.style.left=Math.max(0,Math.min(e.clientX-wrap.getBoundingClientRect().left+12,wrap.clientWidth-150))+"px";tip.style.top="10px"};
  svg.onpointerleave=()=>{tip.style.display="none";const c=$("cur");if(c)c.style.display="none"};
  return {pv,nv};
}

// ================= Calcul et rendu principal =================
let last={};
function refresh(){
  const x=X(), cp=comps(), w=cp.tot, nat=S["00"], Pc=personalI(cp.items), PA=personal(WEXACT);
  const empty0=!anySub()&&CODES.every(c=>state.vals[c]==null||isNaN(state.vals[c])), P=empty0?nat:Pc;
  const i0=state.i0, i1=state.i1, mths=i1-i0;
  const {pv,nv}=drawChart(nat,P,i0,i1);
  const tAvg=CODES.reduce((a,c)=>a+AVG[c],0), empty=empty0, tYou=empty?tAvg:CODES.reduce((a,c)=>a+w[c],0);
