}
const opT=o=>(+o.d.slice(0,4)-2017)*12+(+o.d.slice(5,7)-1);
const opSum=(t,c)=>BUD.ops.reduce((a,o)=>a+(o.c===c&&opT(o)===t?o.a:0),0);
