function opsClean(a){
  const o=[],seen=new Set(); if(!Array.isArray(a))return o;
  a.forEach(e=>{if(!e||typeof e!=="object")return;
    const id=String(e.id||"").slice(0,80),d=String(e.d||""),x=parseFloat(e.a),c=String(e.c||"");
    if(!id||seen.has(id)||!/^\d{4}-\d{2}-\d{2}$/.test(d)||!(x>0)||x>1e7||!(c==="don"||CODES.includes(c)))return;
    const t=(+d.slice(0,4)-2017)*12+(+d.slice(5,7)-1); if(t<0||t>167)return;
    const so={id,d,l:String(e.l||"").slice(0,80),a:Math.round(x*100)/100,c};
    const sk=String(e.s||""); if(sk&&SUBK[sk]&&SUBK[sk].c===c)so.s=sk;
    const fo=String(e.f||"").trim().slice(0,60); if(fo)so.f=fo;
    const dbk=String(e.db||""), crk=String(e.cr||""); if(ACC[dbk]&&dbk[0]==="6")so.db=dbk; if(ACC[crk]&&crk[0]!=="6")so.cr=crk;
    const qq=parseFloat(e.q); if(qq>0&&qq<1e6&&qq!==1)so.q=Math.round(qq*1000)/1000;
    if(e.p)so.p=1; const rv=parseInt(e.r,10); if(rv>0)so.r=rv;
    seen.add(id);o.push(so)});
