function cascade(){
  const d=nowD(), T=(d.getFullYear()-2017)*12+d.getMonth()-1;
  if(T<=LAST)return {T,src:"hcp"};
  const y=2017+Math.floor(T/12), g=growth(y,"bam");
  return {T,y,src:g.s==="hcp"?"hyp":g.s,v:g.v};
}
// indice général prolongé : mois connus du HCP, puis taux mensuel constant calé sur la moyenne annuelle de la source choisie
function buildExt(src){
  const EXT=S["00"].slice(), ESRC=EXT.map(()=>"hcp"), EMON=[];
  for(let y=2017+Math.floor(LAST/12);y<=YEND;y++){
    const f0=(y-2017)*12, n=f0+12-EXT.length; if(n<=0)continue;
    const prev=EXT.slice(f0-12,f0).reduce((a,b)=>a+b,0)/12, g=growth(y,src), target=prev*(1+g.v/100);
    const known=EXT.slice(f0), ks=known.reduce((a,b)=>a+b,0), last=EXT[EXT.length-1];
    const avg=m=>{let s=ks,v=last;for(let j=0;j<n;j++){v*=1+m;s+=v}return s/12};
    let lo=-0.02,hi=0.03;
    for(let k=0;k<60;k++){const mid=(lo+hi)/2;if(avg(mid)<target)lo=mid;else hi=mid}
    const m=Math.min(0.03,Math.max(-0.02,(lo+hi)/2)); EMON.push([y,m]);
    for(let j=0;j<n;j++){EXT.push(EXT[EXT.length-1]*(1+m));ESRC.push(g.s)}
  }
  return {EXT,ESRC,EMON};
}
let FS="bam"; const EXTS={};
const X_=s=>{s=s||FS;return EXTS[s]||(EXTS[s]=buildExt(s))};
const dv=(c,t,s)=>{if(t<=LAST)return S[c][t];const e=X_(s).EXT;return S[c][LAST]*e[t]/e[LAST]};
const yAvg=(y,s)=>{const a=(y-2017)*12;return X_(s).EXT.slice(a,a+12).reduce((x,z)=>x+z,0)/12};
const yInfl=(y,s)=>yAvg(y,s)/yAvg(y-1,s)-1;

