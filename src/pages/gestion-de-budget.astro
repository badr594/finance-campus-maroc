      const last=BUD.ops.filter(o=>nrm(o.f)===nrm(f)).sort((a,b)=>b.d.localeCompare(a.d))[0]; if(last&&(last.c==="don"||CODES.includes(last.c)))$("oCat").value=last.c}};
