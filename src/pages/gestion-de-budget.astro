    if(o.id[0]!=="g")return; const cur=BUD.ops.find(z=>z.id===o.id); if(!cur||(o.r||0)<=(cur.r||0))return;
    cur.c=o.c; cur.l=o.l; cur.a=o.a; cur.r=o.r; ["f","db","cr"].forEach(k=>{if(o[k])cur[k]=o[k]; else delete cur[k]}); if(o.s)cur.s=o.s; else delete cur.s; if(o.p)cur.p=1; else delete cur.p; upd++});
