  $("bmulti").innerHTML=`<table><thead><tr>${x.mTh.map(h=>`<th>${h}</th>`).join("")}</tr></thead><tbody>${ys.map(y=>{const T=totals(y);return `<tr><td>${LR}${y}</td><td>${pct(yInfl(y))}</td><td>${fm(T.inc)}</td><td>${fm(T.need)}</td><td>${T.net==null?"—":sg(T.net)}</td></tr>`}).join("")}</tbody></table>`;
}
