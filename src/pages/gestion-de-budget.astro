   ${top.length?`<div class="card"><h2>${y.fouTop}</h2><table id="ttab"><tbody>${top.map(([n,v])=>`<tr><td>${esc(n)}</td><td><span class="cbar"><i style="width:${Math.round(v/mx*100)}%"></i></span></td><td>${fm(v)}</td></tr>`).join("")}</tbody></table></div>`:""}`;
