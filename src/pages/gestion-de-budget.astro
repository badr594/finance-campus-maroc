    if(!/^\d{4}-\d{2}-\d{2}$/.test(d)||!(a>0)||!(c==="don"||CODES.includes(c))||!PAY[p])return;
    const op={id:"m"+Date.now().toString(36)+Math.random().toString(36).slice(2,6),d,l:l||(c==="don"?x.dDon:nm(c)),a:Math.round(a*100)/100,c,cr:PAY[p]};
    if(f)op.f=f; if(q>0&&q!==1)op.q=Math.round(q*1000)/1000;
    if(f)BUD.sup[supKey(f)||f]={p};
    BUD.ops.push(op); OS.t=opT({d}); renderBud(); budPersist()};
  box.querySelectorAll("button[data-od]").forEach(b=>b.onclick=()=>{const id=b.dataset.od;BUD.ops=BUD.ops.filter(o=>o.id!==id);if(id[0]==="g"&&!BUD.opsDel.includes(id))BUD.opsDel.push(id);renderBud();budPersist()});
}

function supTable(t){
  const g={}; BUD.ops.forEach(o=>{ if(opT(o)!==t&&opT(o)!==t-1)return; const k=o.f?(supKey(o.f)||o.f):""; const e=g[k]||(g[k]={name:k,n:0,tot:0,prev:0}); if(opT(o)===t){e.n++;e.tot+=o.a}else e.prev+=o.a});
  return Object.values(g).filter(e=>e.tot>0).sort((a,b)=>b.tot-a.tot);
}
