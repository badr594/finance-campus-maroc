  box.innerHTML=`<div class="card"><h2>${x.pH}</h2><p>${x.pP}</p>
   <div class="row"><label>${x.fsL} <select id="pFs">${ALLS.map(s=>`<option value="${s}"${s===FS?" selected":""}>${x.fsO[s]}</option>`).join("")}</select></label></div>
   <table style="margin-top:12px"><thead><tr>${x.pT.map(h=>`<th>${h}</th>`).join("")}</tr></thead><tbody>${rows}</tbody></table>
   <p class="note">* ${x.fbk}</p></div>
  <div class="card"><h2>${x.pS(y)}</h2><table><thead><tr>${x.pTh.map(h=>`<th>${h}</th>`).join("")}</tr></thead><tbody>${sr}</tbody></table><p class="note">${x.pN}</p></div>`;
  $("pFs").onchange=e=>setFS(e.target.value);
}
function chart(rs){
  const x=bt(), W=640,H=230,pl=52,pr=12,pt=12,pb=28;
  const ser=[rs.map(r=>r&&r.inc),rs.map(r=>r&&r.bud),rs.map(r=>r&&r.need)], col=["#13804f","#1d4ed8","#b93a09"];
  const vals=ser.flat().filter(v=>v!=null); if(!vals.length){$("bchart").innerHTML="";return}
  let lo=Math.min(...vals),hi=Math.max(...vals); const pad=(hi-lo)*0.12||hi*0.1||100; lo=Math.max(0,lo-pad);hi+=pad;
  const X=i=>pl+i*(W-pl-pr)/11, Y=v=>pt+(hi-v)*(H-pt-pb)/(hi-lo);
  let g="";
  for(let k=0;k<=4;k++){const v=lo+(hi-lo)*k/4,yy=Y(v);g+=`<line x1="${pl}" x2="${W-pr}" y1="${yy}" y2="${yy}" stroke="#e3e6e0"/><text x="${pl-6}" y="${yy+4}" text-anchor="end" font-size="11" fill="#566072">${Math.round(v).toLocaleString("en-US").replace(/,/g," ")}</text>`}
  for(let i=0;i<12;i++)g+=`<text x="${X(i)}" y="${H-8}" text-anchor="middle" font-size="10.5" fill="#566072">${mName(i)}</text>`;
  ser.forEach((s,si)=>{let d="",pen=false;s.forEach((v,i)=>{if(v==null){pen=false;return}d+=(pen?"L":"M")+X(i).toFixed(1)+" "+Y(v).toFixed(1);pen=true});
    if(d)g+=`<path d="${d}" fill="none" stroke="${col[si]}" stroke-width="2.4"${si===1?' stroke-dasharray="6 4"':""}/>`;
    s.forEach((v,i)=>{if(v!=null)g+=`<circle cx="${X(i)}" cy="${Y(v)}" r="2.6" fill="${col[si]}"/>`})});
  const lg=x.lg.map((t,i)=>`<span style="display:inline-flex;align-items:center;gap:6px;margin-inline-end:14px"><i style="width:16px;height:0;border-top:3px ${i===1?"dashed":"solid"} ${col[i]}"></i>${t}</span>`).join("");
  $("bchart").innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(x.chH)}" style="width:100%;height:auto;direction:ltr">${g}</svg><div class="note" style="margin-top:6px">${lg}</div>`;
}
function multi(){
