 sal:(o)=>`<div class="out">Votre salaire a varié de ${sgn(o.g-1)} entre ${o.p0} et ${o.p1}, alors que les prix de votre panier ont varié de ${sgn(o.rP-1)}. Cela représente ${o.v}.</div>
    <div class="out">Pour garder le pouvoir d'achat de ${o.p0}, il vous faudrait <b>${mad(o.need)}</b> par mois. Vous touchez ${mad(o.s1)}, soit <b class="${o.diff>=0?"pos":"neg"}">${o.diff>=0?"+":"−"}${mad(Math.abs(o.diff))}</b> par mois.</div>
    <p class="note">Face à l'indice officiel du panier moyen (${pct(o.rN-1)}), la variation serait de ${pct(o.g/o.rN-1)}.</p>`,
 salNo:"Renseignez les deux salaires pour voir le résultat.",
 smig:(o)=>`<div class="out">Le SMIG mensuel brut est passé de <b>${mad(o.m0)}</b> en ${o.p0} à <b>${mad(o.m1)}</b> en ${o.p1}, soit ${sgn(o.m1/o.m0-1)}. Face aux prix de votre panier (${pct(o.rP-1)}), ${o.v}.</div>
  <p class="note">Face à l'indice officiel du panier moyen : ${pct(o.m1/o.m0/o.rN-1)}.</p>`,
 ep:(o)=>`<div class="out">Votre capital passe de ${mad(o.e0)} à <b>${mad(o.fin)}</b>, avant impôt. Corrigé de la hausse des prix de votre panier, il vaut <b>${mad(o.real)}</b> en dirhams de ${o.p0}, soit ${o.v}.${o.rr==null?"":` Rendement réel annualisé : <b class="${o.rr>=0?"pos":"neg"}">${pct(o.rr)}</b>. Pour ne pas perdre, votre placement devait rapporter au moins <b>${nf(o.need*100,1)} %</b> par an.`}</div>`,
 epNo:"Renseignez le montant et le taux pour voir le résultat.",
 rpH:["","Sur le mois","Sur 12 mois"],rpR:["Indice général, calculé sur les indices publiés","Votre panier","Produits alimentaires (note du HCP)","Produits non alimentaires (note du HCP)","Inflation sous-jacente (note du HCP)"],
 rpN:(pub)=>`L'inflation sous-jacente exclut les produits à prix volatils et les produits à tarifs publics. Elle n'existe que sous forme de taux dans la note du HCP, publiée le ${pub}, donc elle ne se recalcule pas sur votre panier.`,
 yoyH:["Poste","12 mois"],cityH:["Ville","Mois"],cityNo:"Données du dernier mois en cours de mise à jour.",foodH:["Produit","2025 (2017 = 100)"],
 budH:["Poste","IPC (urbain)","Enquête 2014","Enquête 2022"],
