 {k:"hom",f:[{k:"tel",t:"num",div:"08",u:"m"},{k:"clo",t:"num",div:"03",u:"a"},{k:"home",t:"num",div:"05",u:"a"}]},
 {k:"div",f:[{k:"smk",t:"yn"},{k:"smkv",t:"num",div:"02",if:"smk",u:"m"},{k:"fun",t:"num",div:"09",u:"m"},{k:"oth",t:"num",div:"12",u:"m"}]}
];
const wz={step:0,a:{}}; let wzRendered=false;
const ynv=k=>wz.a[k]&&wz.a[k].yn;
function wzCompute(){
  const sum={},ans={},gated={},ungatedAns={};
  CODES.forEach(c=>{sum[c]=0;ans[c]=false;gated[c]=false;ungatedAns[c]=false});
  const hasUngated={};
  WZ.forEach(st=>st.f.forEach(f=>{if(f.t==="num"&&!f.if)hasUngated[f.div]=true}));
  WZ.forEach(st=>st.f.forEach(f=>{
    if(f.t!=="num")return;
    const a=wz.a[f.k]; let v=null;
    if(f.if){
      const g=ynv(f.if);
      if(g===false){v=0}
      else if(g===true&&a&&a.v!==undefined&&a.v!==""&&isFinite(parseFloat(a.v))&&parseFloat(a.v)>=0)v=toMonth(parseFloat(a.v),a.u||f.u);
    } else if(a&&a.v!==undefined&&a.v!==""&&isFinite(parseFloat(a.v))&&parseFloat(a.v)>=0){v=toMonth(parseFloat(a.v),a.u||f.u)}
    if(v==null)return;
    sum[f.div]+=v;
    if(f.if&&v===0) gated[f.div]=true; else ungatedAns[f.div]=true;
  }));
  CODES.forEach(c=>{ans[c]=hasUngated[c]?ungatedAns[c]:gated[c]});
  const pos=CODES.filter(c=>ans[c]&&sum[c]>0);
  let k=1;
  if(pos.length>=3){const a=pos.reduce((s,c)=>s+sum[c],0),b=pos.reduce((s,c)=>s+AVG[c],0);k=Math.min(3,Math.max(0.35,a/b))}
  const any=CODES.some(c=>ans[c]);
  const val={},est={};
  CODES.forEach(c=>{
    if(!any){val[c]=null;est[c]=true}
    else if(ans[c]){val[c]=Math.round(sum[c]);est[c]=false}
    else{val[c]=Math.round(AVG[c]*k/10)*10;est[c]=true}
  });
  return {val,est,any};
}
