  box.querySelectorAll('input[type=radio]').forEach(el=>el.addEventListener("change",()=>{const k=el.name.slice(2);wz.a[k]={yn:el.value==="1"};const keep=el.name;renderWiz();const again=box.querySelector(`input[name="${keep}"][value="${el.value}"]`);if(again)again.focus()}));
  box.querySelectorAll("input[data-wk]").forEach(el=>el.addEventListener("input",()=>{const k=el.dataset.wk;const u=box.querySelector(`select[data-wu="${k}"]`).value;wz.a[k]={v:el.value,u}}));
  box.querySelectorAll("select[data-wu]").forEach(el=>el.addEventListener("change",()=>{const k=el.dataset.wu;const v=box.querySelector(`input[data-wk="${k}"]`).value;wz.a[k]={v,u:el.value}}));
