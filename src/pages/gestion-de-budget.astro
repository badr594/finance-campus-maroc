  t+=`<tr><th>${x.total}</th><th></th><th class="num perso">${fmt(sy,2)}</th><th class="num nat">${fmt(sa,2)}</th></tr>`;
  $("reptable").innerHTML=t;
  const sd2=cp.items.filter(q=>q.k).map(q=>({q,you:contribI(cp.items,Pc,y=>y===q,i0,i1)*100,ch:SS[q.k][i1]/SS[q.k][i0]-1})).sort((a,b)=>b.you-a.you);
  if(sd2.length){const SH=x.subH;$("subbox").innerHTML=`<h2>${x.subT}</h2><p class="note">${x.subTp}</p><table><tr><th>${SH[0]}</th><th class="num">${SH[1]}</th><th class="num">${SH[2]}</th><th class="num">${SH[3]}</th></tr>`+sd2.map(r=>`<tr><td>${sname(SUBK[r.q.k])}</td><td class="num">${mad(r.q.w)}</td><td class="num">${pct(r.ch)}</td><td class="num perso">${fmt(r.you,2)}</td></tr>`).join("")+"</table>"}else $("subbox").innerHTML="";
  updateSubUI();
  $("presetnote").textContent=x.pnote[$("preset").value]||"";
  renderPA({i0,i1,mths,rN,rP,p0,p1});
