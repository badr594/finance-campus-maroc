  ["Rythme annuel moyen, panier moyen",o.yr?pct(o.aN):"—","nat"],["Rythme annuel moyen, vous",o.yr?pct(o.aP):"—","perso"],
  [`12 mois jusqu'à ${o.p1}, panier moyen`,o.has12?pct(o.l12N):"—","nat"],[`12 mois jusqu'à ${o.p1}, vous`,o.has12?pct(o.l12P):"—","perso"]],
 k1:(o)=>[`1 000 MAD de ${o.p0} équivalent à…`,mad(1000*o.rN),`en ${o.p1}, panier moyen`],
 k2:(o)=>[`1 000 MAD de ${o.p0} équivalent à…`,mad(1000*o.rP),`en ${o.p1}, votre panier`],
 hero:(o)=>{
  let h=`<p>Entre <b>${o.p0}</b> et <b>${o.p1}</b>, les prix de votre panier ont varié de <b class="perso">${pct(o.rP-1)}</b>, contre <b class="nat">${pct(o.rN-1)}</b> pour le panier moyen.</p>`;
  const d=(o.rP-o.rN)*100;
  h+=`<p>${Math.abs(d)<0.5?"Votre inflation est proche de la moyenne.":`Votre inflation est de <b>${nf(Math.abs(d),1)} points</b> ${d>0?"au-dessus":"en dessous"} de la moyenne.`}</p>`;
  if(o.has12) h+=`<p>Sur les 12 mois jusqu'à ${o.p1} : <b class="perso">${pct(o.l12P)}</b> pour vous, <b class="nat">${pct(o.l12N)}</b> pour le panier moyen.</p>`;
  const x=o.tot-o.tot/o.rP;
  h+=`<p class="note">Si les montants saisis sont ceux de ${o.p1} (${mad(o.tot)} par mois), le même panier aurait coûté ${mad(o.tot/o.rP)} en ${o.p0} : ${x>=0?`<b>${mad(x)}</b> de plus`:`<b>${mad(-x)}</b> de moins`} par mois aujourd'hui.</p>`;
  return h},
 chartLabel:"Évolution de l'indice de votre panier et de l'indice national",
 tip:(l,a,b)=>`<b>${l}</b><br>Officiel : ${a}<br>Votre panier : ${b}`,
 chartnote:(o)=>`Fin de période (${o.p1}) : indice officiel ${fmt(o.nv,1)}, votre panier ${fmt(o.pv,1)} une fois recalé sur l'indice officiel de ${o.p0}. Écart : ${fmt(o.pv-o.nv,2)} point(s).`,
 cd:["Mois","Officiel","Votre panier"],
 reph:["Poste","Hausse du poste","Contribution, vous (pt)","Contribution, panier moyen (pt)"],total:"Total",
 bh:["Poste","Moyenne (par mois)","Votre dépense (MAD)","Rythme"],units:{m:"Par mois",w:"Par semaine",a:"Par an"},
