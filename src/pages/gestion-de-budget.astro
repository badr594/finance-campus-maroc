function nf(x,d=1){
  const a=Math.abs(x), s=a.toFixed(d), neg=x<0&&Number(s)!==0;
  let [i,f]=s.split("."); i=i.replace(/\B(?=(\d{3})+(?!\d))/g," ");
  return (neg?"−":"")+i+(f?","+f:"");
}
