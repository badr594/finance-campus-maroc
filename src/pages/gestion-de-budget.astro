// ----- inflation personnelle : même produit, même fournisseur, d'un mois à l'autre -----
function etuCalc(){
  const it={}, spend={}; BUD.ops.forEach(o=>{ if(o.c==="don")return; const t=opT(o); spend[t]=(spend[t]||0)+o.a;
    const key=nrm(o.f)+"|"+nrm(o.l), e=it[key]||(it[key]={name:o.l,f:o.f||"",m:{}}), m=e.m[t]||(e.m[t]={a:0,q:0}); m.a+=o.a; m.q+=(o.q||1)});
  const ts=BUD.ops.filter(o=>o.c!=="don").map(opT); if(!ts.length)return null;
  const t0=Math.min(...ts), t1=Math.max(...ts), R={}, det={}, cov={};
  for(let t=t0+1;t<=t1;t++){ let num=0,den=0,list=[];
    Object.values(it).forEach(e=>{const a=e.m[t],b=e.m[t-1]; if(!a||!b)return; const pa=a.a/a.q,pb=b.a/b.q; if(!(pa>0&&pb>0))return; num+=b.a*pa/pb; den+=b.a; list.push({name:e.name,f:e.f,pb,pa,ch:pa/pb-1})});
    if(den>0){R[t]=num/den; det[t]=list.sort((p,q)=>Math.abs(q.ch)-Math.abs(p.ch)); cov[t]={n:list.length,p:Math.round(den/(spend[t-1]||den)*100)}} }
  const idx={[t0]:100}; for(let t=t0+1;t<=t1;t++)idx[t]=idx[t-1]*(R[t]||1);
  return {t0,t1,R,det,cov,idx};
}
function renderEtu(){
  const box=$("etubox"); if(!box)return; const y=xt(), c=etuCalc(), ms=c?Object.keys(c.R).map(Number).sort((a,b)=>b-a):[];
  if(!ms.length){box.innerHTML=`<div class="card"><h2>${y.etuH}</h2><p class="note">${y.etuP}</p><p>${y.etuNeed}</p></div><div class="card"><p class="note">${y.informal}</p></div>`;return}
  if(ETU.t==null||!ms.includes(ETU.t))ETU.t=ms[0]; const t=ETU.t;
  const off=(a,b)=>dv("00",a,FS)/dv("00",b,FS)-1, tile=(k,v,sub)=>`<div class="card" style="flex:1;min-width:150px;margin:0"><div class="note">${k}</div><div style="font-size:1.6em;font-weight:700">${v}</div>${sub?`<div class="note">${sub}</div>`:""}</div>`;
  const mm=c.R[t]-1, st=c.idx[t]/100-1, yy=c.idx[t-12]?c.idx[t]/c.idx[t-12]-1:null;
  const oMM=off(t,t-1), oSt=t-c.t0>0?off(t,c.t0):null, oYY=t>=12?off(t,t-12):null;
  box.innerHTML=`<div class="card"><h2>${y.etuH}</h2><p class="note">${y.etuP}</p>
   <div class="row" style="margin:10px 0"><label>${y.month} <select id="eMonth" aria-label="${esc(y.month)}">${ms.map(i=>`<option value="${i}"${i===t?" selected":""}>${lbl(i)}</option>`).join("")}</select></label></div>
   <div class="row" style="gap:10px;align-items:stretch" id="ekpi">
    ${tile(y.kMonth,pcs(mm),y.kOff+" : "+pcs(oMM))}
    ${tile(y.kStart,pcs(st),y.kOff+" : "+(oSt==null?y.kNone:pcs(oSt)))}
    ${tile(y.kYear,yy==null?y.kNone:pcs(yy),yy==null?"":y.kOff+" : "+(oYY==null?y.kNone:pcs(oYY)))}</div>
   <p class="note" style="margin-top:8px">${y.etuCover(c.cov[t].n,c.cov[t].p)} ${y.etuGap}</p>
   <div style="overflow-x:auto"><table id="etab"><thead><tr>${y.eCols.map(h=>`<th>${h}</th>`).join("")}</tr></thead><tbody>${c.det[t].map(r=>`<tr><td>${esc(r.name)}</td><td>${esc(r.f||"—")}</td><td>${mad2(r.pb)}</td><td>${mad2(r.pa)}</td><td><b class="${r.ch>0?"neg":r.ch<0?"pos":""}">${pcs(r.ch)}</b></td></tr>`).join("")}</tbody></table></div>
   <p class="note">${y.unit}</p></div>
   <div class="card"><p class="note">${y.informal}</p></div>`;
  $("eMonth").onchange=e=>{ETU.t=+e.target.value;renderEtu()};
}
const ETU={t:null};

const FOLDS={};
function foldify(){
  document.querySelectorAll(".card.opt").forEach(c=>{
    if(c.dataset.fold)return;
    const h=c.querySelector("h2"); if(!h||h.parentNode!==c)return;
    const pn=c.closest(".panel"), key=c.dataset.fk||((pn?pn.id:"")+":"+[...(pn||document).querySelectorAll(".card.opt")].indexOf(c));
    c.dataset.fold=key;
    const body=document.createElement("div"); body.className="foldbody";
    while(h.nextSibling)body.appendChild(h.nextSibling);
    c.appendChild(body);
    const open=FOLDS[key]===undefined?c.dataset.open==="1":FOLDS[key]===true; body.hidden=!open;
    h.classList.add("foldh"); h.setAttribute("role","button"); h.tabIndex=0; h.setAttribute("aria-expanded",open?"true":"false");
    const tg=()=>{const o=body.hidden;body.hidden=!o;h.setAttribute("aria-expanded",o?"true":"false");FOLDS[key]=o};
    h.onclick=tg; h.onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();tg()}};
  });
}
function cityTable(x){
  const rows=CITY.map(c=>({c,a:c.h[115]/c.h[103]-1,s:c.h[LK]/100-1})).sort((p,q)=>q.a-p.a);
  const nat={a:NATC.h[115]/NATC.h[103]-1,s:NATC.h[LK]/100-1}, mx=Math.max(...rows.map(r=>Math.abs(r.a)),Math.abs(nat.a))||1;
  const bar=v=>`<span class="cbar"><i style="width:${Math.round(Math.abs(v)/mx*100)}%;${v<0?"background:#b4533c":""}"></i></span>`;
  const f=v=>lang==="ar"?LR+(v>=0?"+":"")+nf(v*100,1)+" %"+LR:(v>=0?"+":"")+nf(v*100,1)+" %";
  const tr=(name,reg,a,s,cur,k)=>`<tr${cur?' class="cur"':""}><td>${esc(name)}${reg?`<span class="note"> · ${esc(reg)}</span>`:""}</td><td>${f(a)}</td><td>${bar(a)}</td><td>${f(s)}</td></tr>`;
  return `<table class="ctt"><thead><tr><th>${x.ctTh[0]}</th><th>${x.ctTh[1]}</th><th></th><th>${x.ctTh[2]}</th></tr></thead><tbody>${tr(x.pfAll,"",nat.a,nat.s,!BUD.city)}${rows.map(r=>tr(cname(r.c),rname(r.c.r),r.a,r.s,BUD.city===r.c.k)).join("")}</tbody></table>`;
}
function calcInfl(){
  const x=bt(), box=$("infk"); if(!box)return;
  const t=REF==="bam"?SRC.bam.m.t:LAST, tm=lbl(t), y=BUD.y;
  const my=basketAt(t)/basketAt(t-12)-1, mm=basketAt(t)/basketAt(t-1)-1;
  const off=REF==="bam"?SRC.bam.m.yy/100:offIdx(t)/offIdx(t-12)-1;
  const pAvg=yy=>{let s=0;for(let m=0;m<12;m++)s+=basketAt((yy-2017)*12+m);return s/12};
  const oAvg=yy=>{let s=0;for(let m=0;m<12;m++)s+=offIdx((yy-2017)*12+m);return s/12};
  const my2=pAvg(y)/pAvg(y-1)-1, off2=oAvg(y)/oAvg(y-1)-1;
  const csub=BUD.prof==="rur"?x.cRur:(BUD.city?x.cCity(cname(CITYK[BUD.city])):"HCP");
  const kp=(a,b,c)=>`<div class="kpi"><div class="note">${a}</div><div class="kv">${b}</div>${c?`<div class="note">${c}</div>`:""}</div>`;
  const gap=(my-off)*100;
  box.innerHTML=kp(x.iK1(tm),pct(my),x.cmp(lbl(t-12)))+kp(x.iK2,pct(off),REF==="bam"?"Bank Al-Maghrib":csub)+kp(x.iK3,(gap>0?"+":"")+nf(gap,1)+(lang==="ar"?" نقطة":" pt"),"")+kp(x.iK6(tm),pct(mm),x.cmp(lbl(t-1)))+kp(x.iK4(y),pct(my2),x.cmp(y-1))+kp(x.iK5(x.fsO[FS]),pct(off2),x.cmp(y-1));
}
function setFS(v){FS=v;renderBud();renderPrev();renderSrc();budPersist()}
function renderPrev(){
