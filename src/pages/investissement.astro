---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Espace Investissement & Quiz - Finance Campus Maroc">
  <section class="max-w-4xl mx-auto px-6 py-12">
    
    {/* En-tête */}
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Auto-Évaluation Interactive
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Quiz Investissement & Marchés
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed">
        Testez et consolidez vos connaissances financières. Les questions changent à chaque nouvelle tentative !
      </p>
    </div>

    {/* Bloc de Quiz */}
    <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-6 md:p-10 backdrop-blur-sm shadow-2xl">
      
      {/* Barre de progression & Score */}
      <div id="quiz-header" class="flex justify-between items-center mb-8 pb-4 border-b border-slate-700/60">
        <span id="question-count" class="text-xs font-semibold uppercase tracking-wider text-emerald-400">
          Question 1 sur 5
        </span>
        <span id="score-tracker" class="text-xs font-semibold bg-slate-900 px-3 py-1.5 rounded-full text-slate-300 border border-slate-700">
          Score : 0
        </span>
      </div>

      {/* Conteneur de Question */}
      <div id="quiz-box">
        <h2 id="question-text" class="text-lg md:text-xl font-bold text-white mb-6 leading-snug">
          Chargement des questions...
        </h2>

        {/* Options de réponse */}
        <div id="options-container" class="space-y-3 mb-6">
          {/* Les boutons d'options sont générés dynamiquement via JS */}
        </div>

        {/* Explication après réponse */}
        <div id="explanation-box" class="hidden p-4 rounded-xl text-xs md:text-sm leading-relaxed mb-6 border"></div>

        {/* Bouton Suivant */}
        <div class="flex justify-end">
          <button 
            id="next-btn" 
            class="hidden px-6 py-3 rounded-xl bg-emerald-500 text-slate-950 font-bold text-sm hover:bg-emerald-400 transition cursor-pointer"
          >
            Question suivante &rarr;
          </button>
        </div>
      </div>

      {/* Écran des Résultats Finaux */}
      <div id="results-box" class="hidden text-center py-8 space-y-6">
        <div class="inline-flex p-4 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-3xl mb-2">
          🏆
        </div>
        <h2 class="text-2xl font-bold text-white">Quiz Terminé !</h2>
        <p id="final-score-text" class="text-slate-300 text-lg"></p>
        <p id="final-feedback" class="text-slate-400 text-sm max-w-md mx-auto"></p>
        
        <div class="pt-4">
          <button 
            id="restart-btn" 
            class="px-8 py-3.5 rounded-xl bg-emerald-500 text-slate-950 font-bold text-sm hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20 cursor-pointer"
          >
            🔄 Actualiser & Recommencer avec de nouvelles questions
          </button>
        </div>
      </div>

    </div>

  </section>
</Layout>

<script>
  // Banque de questions actualisées et diversifiées
  const questionBank = [
    {
      question: "Quel est l'indice boursier de référence de la Bourse de Casablanca ?",
      options: ["CAC 40", "MASI (Moroccan All Shares Index)", "S&P 500", "Dow Jones"],
      correct: 1,
      explanation: "Le MASI est l'indice global représentant toutes les actions cotées à la Bourse de Casablanca."
    },
    {
      question: "Que représente le 'Dividend Yield' (Rendement du dividende) ?",
      options: [
        "Le dividende annuel divisé par le prix de l'action",
        "La plus-value réalisée lors de la revente d'une action",
        "Le bénéfice net total réalisé par la société",
        "Le taux d'intérêt fixé par la banque centrale"
      ],
      correct: 0,
      explanation: "Le Dividend Yield mesure le pourcentage de retour en dividende par rapport au prix d'achat actuel de l'action."
    },
    {
      question: "Que signifie l'acronyme OPCVM ?",
      options: [
        "Organisme de Placement Collectif en Valeurs Mobilières",
        "Obligation Publique pour la Croissance et la Valorisation des Marchés",
        "Opération de Portefeuille Commun Virtuel et Marchand",
        "Organisation Personnelle de Contrôle des Valeurs Monétaires"
      ],
      correct: 0,
      explanation: "Les OPCVM (SICAV et FCP) permettent aux épargnants de placer leur argent en commun géré par des professionnels."
    },
    {
      question: "En analyse technique, que signale un motif en 'Double Fond' (Double Bottom) ?",
      options: [
        "Une continuation de la tendance baissière",
        "Un retournement imminent de la baisse vers la hausse",
        "Une baisse immédiate du volume de transaction",
        "Une faillite de l'entreprise"
      ],
      correct: 1,
      explanation: "Le double fond est une figure chartiste classique de retournement haussier après une phase de baisse."
    },
    {
      question: "Quelle est la principale différence entre une action et une obligation ?",
      options: [
        "L'action est un titre de créance, l'obligation est une part de capital",
        "L'action est une part de capital (propriété), l'obligation est une créance (dette)",
        "Les obligations n'existent pas sur le marché financier marocain",
        "Une action garantit un remboursement du capital à 100%"
      ],
      correct: 1,
      explanation: "L'actionnaire est copropriétaire de l'entreprise, tandis que l'obligataire est un créancier qui prête de l'argent contre des intérêts."
    },
    {
      question: "Quelle institution assure la régulation et le contrôle du marché des capitaux au Maroc ?",
      options: [
        "BAM (Bank Al-Maghrib)",
        "AMMC (Autorité Marocaine du Marché des Capitaux)",
        "Ministère des Finances uniquement",
        "La Bourse de Casablanca directement"
      ],
      correct: 1,
      explanation: "L'AMMC est l'autorité publique chargée de veiller à la protection de l'épargne investie en instruments financiers."
    },
    {
      question: "Qu'est-ce que le 'PER' (Price Earning Ratio) d'une action ?",
      options: [
        "Le cours de l'action divisé par le bénéfice net par action (BNPA)",
        "Le prix de vente recommandé par les analystes",
        "Le pourcentage de frais de courtage prélevé sur un ordre",
        "Le rendement annuel du compte sur carnet"
      ],
      correct: 0,
      explanation: "Le PER indique combien de fois le bénéfice annuel est payé à travers le cours de bourse."
    },
    {
      question: "Que permet d'évaluer le ratio de Sharpe pour un portefeuille ?",
      options: [
        "Le rendement ajusté par rapport au risque pris",
        "Le nombre total de titres contenus dans le portefeuille",
        "Les frais de gestion annuels",
        "La durée exacte d'immobilisation des fonds"
      ],
      correct: 0,
      explanation: "Plus le ratio de Sharpe est élevé, plus le portefeuille rémunère efficacement le risque encouru."
    }
  ];

  let activeQuestions = [];
  let currentQuestionIndex = 0;
  let score = 0;

  // Éléments du DOM
  const questionText = document.getElementById('question-text');
  const optionsContainer = document.getElementById('options-container');
  const explanationBox = document.getElementById('explanation-box');
  const nextBtn = document.getElementById('next-btn');
  const questionCount = document.getElementById('question-count');
  const scoreTracker = document.getElementById('score-tracker');
  const quizBox = document.getElementById('quiz-box');
  const resultsBox = document.getElementById('results-box');
  const finalScoreText = document.getElementById('final-score-text');
  const finalFeedback = document.getElementById('final-feedback');
  const restartBtn = document.getElementById('restart-btn');
  const quizHeader = document.getElementById('quiz-header');

  // Sélectionne 5 questions au hasard
  function getRandomQuestions() {
    const shuffled = [...questionBank].sort(() => 0.5 - Math.random());
    return shuffled.slice(0, 5);
  }

  function startQuiz() {
    activeQuestions = getRandomQuestions();
    currentQuestionIndex = 0;
    score = 0;
    
    if (quizBox) quizBox.classList.remove('hidden');
    if (quizHeader) quizHeader.classList.remove('hidden');
    if (resultsBox) resultsBox.classList.add('hidden');
    
    updateScoreUI();
    loadQuestion();
  }

  function updateScoreUI() {
    if (scoreTracker) scoreTracker.textContent = `Score : ${score}/${activeQuestions.length}`;
  }

  function loadQuestion() {
    const q = activeQuestions[currentQuestionIndex];
    
    if (questionCount) questionCount.textContent = `Question ${currentQuestionIndex + 1} sur ${activeQuestions.length}`;
    if (questionText) questionText.textContent = q.question;
    if (explanationBox) {
      explanationBox.classList.add('hidden');
      explanationBox.className = "hidden p-4 rounded-xl text-xs md:text-sm leading-relaxed mb-6 border";
    }
    if (nextBtn) nextBtn.classList.add('hidden');

    if (optionsContainer) {
      optionsContainer.innerHTML = '';
      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = "w-full text-left p-4 rounded-xl bg-slate-900/80 border border-slate-700/80 text-white text-sm font-medium hover:border-emerald-500/60 hover:bg-slate-900 transition flex items-center justify-between cursor-pointer";
        btn.innerHTML = `<span>${opt}</span><span class="text-xs text-slate-500 border border-slate-700 px-2 py-0.5 rounded">${String.fromCharCode(65 + idx)}</span>`;
        btn.addEventListener('click', () => selectAnswer(idx, q.correct, q.explanation));
        optionsContainer.appendChild(btn);
      });
    }
  }

  function selectAnswer(selectedIdx, correctIdx, explanation) {
    const buttons = optionsContainer?.querySelectorAll('button');
    if (!buttons) return;

    // Désactiver tous les boutons
    buttons.forEach((btn, idx) => {
      btn.disabled = true;
      btn.classList.remove('hover:border-emerald-500/60', 'cursor-pointer');
      
      if (idx === correctIdx) {
        btn.classList.add('border-emerald-500', 'bg-emerald-500/10', 'text-emerald-400');
      } else if (idx === selectedIdx && selectedIdx !== correctIdx) {
        btn.classList.add('border-red-500', 'bg-red-500/10', 'text-red-400');
      } else {
        btn.classList.add('opacity-40');
      }
    });

    if (selectedIdx === correctIdx) {
      score++;
      updateScoreUI();
      if (explanationBox) {
        explanationBox.classList.remove('hidden');
        explanationBox.classList.add('border-emerald-500/30', 'bg-emerald-500/10', 'text-emerald-300');
        explanationBox.innerHTML = `<strong>Excellente réponse !</strong> ${explanation}`;
      }
    } else {
      if (explanationBox) {
        explanationBox.classList.remove('hidden');
        explanationBox.classList.add('border-red-500/30', 'bg-red-500/10', 'text-red-300');
        explanationBox.innerHTML = `<strong>Mauvaise réponse.</strong> ${explanation}`;
      }
    }

    if (nextBtn) {
      nextBtn.classList.remove('hidden');
      if (currentQuestionIndex === activeQuestions.length - 1) {
        nextBtn.textContent = "Voir les résultats 🏁";
      } else {
        nextBtn.textContent = "Question suivante →";
      }
    }
  }

  nextBtn?.addEventListener('click', () => {
    currentQuestionIndex++;
    if (currentQuestionIndex < activeQuestions.length) {
      loadQuestion();
    } else {
      showResults();
    }
  });

  function showResults() {
    if (quizBox) quizBox.classList.add('hidden');
    if (quizHeader) quizHeader.classList.add('hidden');
    if (resultsBox) resultsBox.classList.remove('hidden');

    if (finalScoreText) {
      finalScoreText.textContent = `Votre score : ${score} / ${activeQuestions.length}`;
    }

    if (finalFeedback) {
      const percentage = (score / activeQuestions.length) * 100;
      if (percentage === 100) {
        finalFeedback.textContent = "Parfait ! Vous maîtrisez parfaitement les fondamentaux des marchés et de l'investissement.";
      } else if (percentage >= 60) {
        finalFeedback.textContent = "Bon travail ! Vos bases sont solides. Continuez à vous exercer pour atteindre le sans-faute.";
      } else {
        finalFeedback.textContent = "N'hésitez pas à relire les cours et le dictionnaire de l'académie pour consolider vos compétences !";
      }
    }
  }

  restartBtn?.addEventListener('click', startQuiz);

  // Démarrage initial
  startQuiz();
</script>