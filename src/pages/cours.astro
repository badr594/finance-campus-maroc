---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cours et Ressources - Club Finance ENCG Tanger">
  <section class="max-w-7xl mx-auto px-6 py-12">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Espace Pédagogique
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Cours et Ressources Académiques
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed text-justify mb-8">
        Retrouvez l'ensemble des supports de cours, résumés de travaux dirigés et documents de référence partagés par le Club Finance pour soutenir votre parcours académique à l'ENCG Tanger.
      </p>

      {/* Barre de recherche interne pour les cours */}
      <div class="relative max-w-xl mx-auto">
        <input
          type="text"
          id="course-search"
          placeholder="Rechercher un module ou un document..."
          class="w-full px-5 py-3.5 bg-slate-900/80 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500/80 focus:ring-1 focus:ring-emerald-500/80 transition text-sm shadow-inner"
        />
      </div>
    </div>

    {/* Grille des catégories de cours */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="courses-grid">
      
      {/* Carte 1 */}
      <div class="course-card p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl hover:border-emerald-500/40 transition flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 block">Finance d'entreprise</span>
          <h3 class="course-title text-lg font-bold text-white mb-2">Évaluation des Projets d'Investissement</h3>
          <p class="course-desc text-slate-300 text-xs leading-relaxed text-justify mb-6">
            Supports détaillés sur le calcul de la VAN, du TRI, du délai de récupération du capital investi et l'analyse des flux de trésorerie prévisionnels (Free Cash Flows).
          </p>
        </div>
        <a href="#" class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-semibold border border-emerald-500/30 rounded-xl transition">
          Télécharger le support
        </a>
      </div>

      {/* Carte 2 */}
      <div class="course-card p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl hover:border-emerald-500/40 transition flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 block">Marchés des capitaux</span>
          <h3 class="course-title text-lg font-bold text-white mb-2">Introduction aux Marchés Financiers</h3>
          <p class="course-desc text-slate-300 text-xs leading-relaxed text-justify mb-6">
            Analyse des structures de marché, introduction aux produits dérivés, fonctionnement des bourses de valeurs et mécanismes de cotation des titres.
          </p>
        </div>
        <a href="#" class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-semibold border border-emerald-500/30 rounded-xl transition">
          Télécharger le support
        </a>
      </div>

      {/* Carte 3 */}
      <div class="course-card p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl hover:border-emerald-500/40 transition flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 block">Finance islamique</span>
          <h3 class="course-title text-lg font-bold text-white mb-2">Instruments et Contrats Alternatifs</h3>
          <p class="course-desc text-slate-300 text-xs leading-relaxed text-justify mb-6">
            Étude approfondie des principes de la finance participative, des contrats de type Ijarah, Mourabaha et de l'émission d'obligations Soukuks.
          </p>
        </div>
        <a href="#" class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-semibold border border-emerald-500/30 rounded-xl transition">
          Télécharger le support
        </a>
      </div>

      {/* Carte 4 */}
      <div class="course-card p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl hover:border-emerald-500/40 transition flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 block">Analyse financière</span>
          <h3 class="course-title text-lg font-bold text-white mb-2">Diagnostic Financier et Ratios</h3>
          <p class="course-desc text-slate-300 text-xs leading-relaxed text-justify mb-6">
            Méthodologie d'analyse du bilan fonctionnel, du compte de produits et charges (CPC), calcul du fonds de roulement, besoin en fonds de roulement et trésorerie nette.
          </p>
        </div>
        <a href="#" class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-semibold border border-emerald-500/30 rounded-xl transition">
          Télécharger le support
        </a>
      </div>

      {/* Carte 5 */}
      <div class="course-card p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl hover:border-emerald-500/40 transition flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 block">Modélisation</span>
          <h3 class="course-title text-lg font-bold text-white mb-2">Excel Avancé pour la Finance</h3>
          <p class="course-desc text-slate-300 text-xs leading-relaxed text-justify mb-6">
            Mise en pratique des outils de modélisation financière, tableaux croisés dynamiques, fonctions financières avancées et construction de business plans automatisés.
          </p>
        </div>
        <a href="#" class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-semibold border border-emerald-500/30 rounded-xl transition">
          Télécharger le support
        </a>
      </div>

      {/* Carte 6 */}
      <div class="course-card p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl hover:border-emerald-500/40 transition flex flex-col justify-between">
        <div>
          <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-2 block">Préparation professionnelle</span>
          <h3 class="course-title text-lg font-bold text-white mb-2">Guide des Entretiens en Finance</h3>
          <p class="course-desc text-slate-300 text-xs leading-relaxed text-justify mb-6">
            Recueil de questions techniques fréquentes, études de cas d'entretiens en banque d'investissement et conseils pour réussir ses stages en finance.
          </p>
        </div>
        <a href="#" class="inline-flex items-center justify-center w-full px-4 py-2.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 text-xs font-semibold border border-emerald-500/30 rounded-xl transition">
          Télécharger le support
        </a>
      </div>

    </div>
  </section>
</Layout>

<script>
  const searchInput = document.getElementById('course-search') as HTMLInputElement;
  const courseCards = document.querySelectorAll('.course-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

      courseCards.forEach((card) => {
        const title = card.querySelector('.course-title')?.textContent?.toLowerCase() || '';
        const desc = card.querySelector('.course-desc')?.textContent?.toLowerCase() || '';

        if (title.includes(query) || desc.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>