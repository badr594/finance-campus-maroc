---
import Layout from '../layouts/Layout.astro';

const coursList = [
  {
    id: "gestion-portefeuille",
    title: "Gestion de Portefeuille",
    badge: "Niveau Avancé",
    description: "Théorie moderne du portefeuille, allocation d'actifs, modèle MEDAF (CAPM), diversification et évaluation de la performance (ratios de Sharpe, Treynor et Jensen).",
    pdfUrl: "/docs/gestion-portefeuille.pdf",
    tags: ["MEDAF", "Asset Allocation", "Sharpe"]
  },
  {
    id: "excel-finance",
    title: "Excel Appliqué à la Finance",
    badge: "Pratique & Outils",
    description: "Modélisation financière sous Excel : formules financières avancées (TRI, VAN, VPM), tables de sensibilité, graphiques dynamiques et analyse de données boursières.",
    pdfUrl: "/docs/excel-finance.pdf",
    tags: ["TRI / VAN", "Modélisation", "Formules"]
  },
  {
    id: "marche-capitaux",
    title: "Marché des Capitaux",
    badge: "Fondamentaux",
    description: "Structure et fonctionnement du marché financier : marché monétaire, marché obligataire, marché des actions (Bourse de Casablanca) et instruments dérivés.",
    pdfUrl: "/docs/marche-capitaux.pdf",
    tags: ["MASI", "Obligations", "AMMC"]
  }
];
---

<Layout title="Cours & Supports - Finance Campus Maroc">
  <main class="max-w-6xl mx-auto px-6 py-12">
    
    {/* En-tête de la page */}
    <div class="mb-12 text-center">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Ressources Académiques
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Cours & Supports Pédagogiques
      </h1>
      <p class="text-slate-400 text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
        Accédez aux modules fondamentaux et téléchargez les supports de cours au format PDF pour accompagner votre apprentissage.
      </p>
    </div>

    {/* Grille des 3 cours */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {coursList.map(cours => (
        <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-6 backdrop-blur-sm shadow-xl flex flex-col justify-between transition hover:border-slate-600">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs px-3 py-1 rounded-full border font-semibold bg-emerald-500/10 text-emerald-400 border-emerald-500/30">
                {cours.badge}
              </span>
            </div>

            <h2 class="text-xl font-bold text-white mb-3">
              {cours.title}
            </h2>

            <p class="text-slate-400 text-xs md:text-sm leading-relaxed mb-6">
              {cours.description}
            </p>

            <div class="flex flex-wrap gap-2 mb-6">
              {cours.tags.map(tag => (
                <span class="text-xs bg-slate-900 text-slate-400 px-2.5 py-1 rounded-lg border border-slate-800">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          <div>
            <a 
              href={cours.pdfUrl} 
              download 
              class="w-full py-3 px-4 rounded-xl text-xs md:text-sm font-bold bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition inline-flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/10"
            >
              Télécharger le cours PDF &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>

  </main>
</Layout>