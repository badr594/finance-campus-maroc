---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    title: "Finance d'Entreprise",
    description: "Choix d'investissement, structure de capital, évaluation d'entreprises et gestion de trésorerie.",
    icon: "💼",
    count: "4 Modules"
  },
  {
    title: "Marchés Financiers & Capitaux",
    description: "Instruments financiers, gestion de portefeuille, bourse et marchés obligataires.",
    icon: "📈",
    count: "5 Modules"
  },
  {
    title: "Analyse Financière & Diagnostic",
    description: "Étude des états financiers, ratios de rentabilité, solvabilité et flux de trésorerie.",
    icon: "📊",
    count: "3 Modules"
  },
  {
    title: "Finance Islamique & Alternative",
    description: "Principes de la finance participative, contrats Sukuk, Murabaha et Ijarah.",
    icon: "🏛️",
    count: "3 Modules"
  }
];

const courses = [
  {
    title: "Gestion Financière à Long Terme",
    category: "Finance d'Entreprise",
    description: "Méthodes VAN, TRI, délai de récupération et choix de financement des investissements.",
  },
  {
    title: "Analyse des États Financiers",
    category: "Analyse Financière",
    description: "Restructuration du bilan, SIG, capacité d'autofinancement (CAF) et analyse par les ratios.",
  },
  {
    title: "Marchés d'Actions et d'Obligations",
    category: "Marchés Financiers",
    description: "Fonctionnement de la Bourse de Casablanca, évaluation des titres et gestion du risque.",
  },
  {
    title: "Introduction aux Instruments de la Finance Participative",
    category: "Finance Islamique",
    description: "Fondements juridiques et économiques des produits bancaires participatifs au Maroc.",
  }
];
---

<Layout title="Cours & Ressources - Finance Campus Maroc">
  <main class="max-w-7xl mx-auto px-6 py-16">
    <div class="mb-12">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-4">
        Espace Pédagogique
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
        Cours & <span class="text-emerald-500">Ressources Académiques</span>
      </h1>
      <p class="text-slate-400 text-base max-w-2xl">
        Consultez et téléchargez les modules de formation, résumés et supports de cours en finance.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {categories.map((cat) => (
        <div class="bg-slate-800/40 border border-slate-700/60 rounded-2xl p-6 hover:border-emerald-500/40 transition duration-300">
          <div class="text-3xl mb-4">{cat.icon}</div>
          <span class="text-[11px] font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/20">
            {cat.count}
          </span>
          <h3 class="text-lg font-bold text-white mt-4 mb-2">{cat.title}</h3>
          <p class="text-slate-400 text-xs leading-relaxed">{cat.description}</p>
        </div>
      ))}
    </div>

    <div class="mb-8 flex justify-between items-center">
      <h2 class="text-2xl font-bold text-white">Supports de Cours Disponibles</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {courses.map((course) => (
        <div class="bg-slate-800/40 border border-slate-700/60 rounded-2xl p-6 flex flex-col justify-between hover:border-slate-600 transition">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-slate-400 bg-slate-900 px-3 py-1 rounded-lg border border-slate-800">
                {course.category}
              </span>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">{course.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">{course.description}</p>
          </div>

          <div class="pt-4 border-t border-slate-700/40 flex justify-between items-center">
            <span class="text-xs text-slate-500">Document PDF</span>
            <button class="px-4 py-2 text-xs font-semibold bg-emerald-500 hover:bg-emerald-600 text-slate-950 rounded-xl transition">
              Accéder au cours
            </button>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
