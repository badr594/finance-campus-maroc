---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Le Club - Finance Campus Maroc">
  <div class="min-h-screen bg-slate-950 text-white py-12 px-6">
    <main class="max-w-6xl mx-auto">
      
      {/* En-tête */}
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 inline-block mb-4">
          Mandat 2026 / 2027 - ENCG Tanger
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-4 tracking-tight">
          À propos du <span class="text-emerald-400">Club Finance</span>
        </h1>
        <p class="text-slate-300 text-base md:text-lg leading-relaxed">
          Le Club Finance de l'ENCG Tanger est une association estudiantine dynamique dédiée à la promotion de la culture financière.
        </p>
      </div>

      {/* Cadre de la Photo de l'Équipe (Visages 100% visibles) */}
      <div class="relative w-full h-[450px] rounded-3xl overflow-hidden mb-12 border border-slate-800 shadow-2xl">
        <img 
          src="/club-team.jpg" 
          alt="Équipe Club Finance" 
          class="w-full h-full object-cover object-center"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-60"></div>
      </div>

      {/* Cartes d'information sous la photo */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 backdrop-blur-md flex flex-col justify-between">
          <div>
            <h2 class="text-2xl font-bold text-white mb-4">Notre Mission</h2>
            <p class="text-slate-300 text-sm leading-relaxed mb-6">
              Le Club Finance de l'ENCG Tanger vise à développer les compétences pratiques des étudiants dans le marché des capitaux, la gestion de portefeuille et la finance d'entreprise.
            </p>
          </div>
          <a href="/contact" class="px-6 py-3 rounded-xl font-bold text-xs bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition inline-block text-center w-fit">
            Nous contacter &rarr;
          </a>
        </div>

        <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-8 backdrop-blur-md flex flex-col justify-between">
          <div>
            <h2 class="text-2xl font-bold text-white mb-4">Nos Activités</h2>
            <ul class="space-y-3 text-slate-300 text-sm mb-6">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Simulations d'investissements et compétitions de trading
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Conférences d'intégration et séminaires professionnels
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Formations académiques et ateliers pratiques
              </li>
            </ul>
          </div>
          <a href="/cours" class="px-6 py-3 rounded-xl font-bold text-xs bg-slate-800 border border-slate-700 text-white hover:bg-slate-700 transition inline-block text-center w-fit">
            Voir les activités &rarr;
          </a>
        </div>

      </div>

    </main>
  </div>
</Layout>