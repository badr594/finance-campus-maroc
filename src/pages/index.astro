---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Finance Campus Maroc - Académie & Club Finance ENCGT">
  <main class="max-w-6xl mx-auto px-6 py-10">
    
    {/* Bandeau Ticker de Marché Défilant */}
    <div class="mb-10 overflow-hidden bg-slate-900/90 border border-slate-800 rounded-2xl py-2.5 px-4 text-xs font-mono text-slate-400 flex items-center gap-6">
      <span class="text-emerald-400 font-bold uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        MARCHÉ
      </span>
      <div class="flex gap-8 whitespace-nowrap overflow-x-auto no-scrollbar">
        <span>MASI : <strong class="text-white">13 850 pts</strong> <span class="text-emerald-400">+0.45%</span></span>
        <span class="text-slate-700">|</span>
        <span>TAUX DIRECTEUR BAM : <strong class="text-white">2.75%</strong></span>
        <span class="text-slate-700">|</span>
        <span>OPCVM ACTIFS : <strong class="text-white">620 Mrd MAD</strong></span>
        <span class="text-slate-700">|</span>
        <span>ATTIJARIWAFA : <strong class="text-white">510 MAD</strong> <span class="text-emerald-400">+0.8%</span></span>
      </div>
    </div>

    {/* Hero Section Institutionnel */}
    <div class="text-center max-w-4xl mx-auto mb-16 pt-4">
      <span class="px-4 py-1.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-4">
        ENCG Tanger • Club Finance
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight leading-tight">
        L'Académie de référence dédiée à la <span class="text-emerald-400">Finance de Marché & d'Entreprise</span>
      </h1>
      <p class="text-slate-400 text-base md:text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
        Plateforme d'apprentissage intégrée : ressources académiques, analyses des marchés financiers marocains et outils pratiques de modélisation.
      </p>
      
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/cours" class="px-8 py-4 rounded-xl font-bold text-sm bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20">
          Explorer la formation &rarr;
        </a>
        <a href="/investissement" class="px-8 py-4 rounded-xl font-bold text-sm bg-slate-800 border border-slate-700 text-white hover:bg-slate-700 transition">
          Suivre l'indice MASI
        </a>
      </div>
    </div>

    {/* Section Chiffres Clés / Impact */}
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16 bg-slate-800/30 border border-slate-700/50 rounded-3xl p-6 backdrop-blur-sm text-center">
      <div>
        <div class="text-2xl md:text-3xl font-extrabold text-white">03</div>
        <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Modules Majeurs</div>
      </div>
      <div>
        <div class="text-2xl md:text-3xl font-extrabold text-emerald-400">100%</div>
        <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Accès Académique</div>
      </div>
      <div>
        <div class="text-2xl md:text-3xl font-extrabold text-white">MASI</div>
        <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Cotation BVC</div>
      </div>
      <div>
        <div class="text-2xl md:text-3xl font-extrabold text-emerald-400">ENCGT</div>
        <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Pole Excellence</div>
      </div>
    </div>

    {/* Orientations par Métiers & Compétences */}
    <div class="mb-16">
      <div class="text-center mb-10">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Parcours & Spécialisations</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white mt-1">Développez des compétences clés</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm flex flex-col justify-between hover:border-emerald-500/50 transition">
          <div>
            <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">Marchés Financiers</div>
            <h3 class="text-xl font-bold text-white mb-3">Gestion de Portefeuille</h3>
            <p class="text-slate-400 text-xs md:text-sm leading-relaxed mb-6">
              Maîtrisez l'allocation d'actifs, le modèle MEDAF/CAPM et la mesure de performance via les ratios de Sharpe et Jensen.
            </p>
          </div>
          <a href="/cours" class="text-xs font-bold text-emerald-400 hover:underline">Consulter le cours &rarr;</a>
        </div>

        <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm flex flex-col justify-between hover:border-emerald-500/50 transition">
          <div>
            <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">Analyse Quantinative</div>
            <h3 class="text-xl font-bold text-white mb-3">Excel Financier</h3>
            <p class="text-slate-400 text-xs md:text-sm leading-relaxed mb-6">
              Modélisez des flux de trésorerie, calculez la VAN/TRI et construisez des tableaux de bord financiers professionnels.
            </p>
          </div>
          <a href="/cours" class="text-xs font-bold text-emerald-400 hover:underline">Consulter le cours &rarr;</a>
        </div>

        <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm flex flex-col justify-between hover:border-emerald-500/50 transition">
          <div>
            <div class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">Financement & Titres</div>
            <h3 class="text-xl font-bold text-white mb-3">Marché des Capitaux</h3>
            <p class="text-slate-400 text-xs md:text-sm leading-relaxed mb-6">
              Comprenez l'articulation entre le marché monétaire, obligataire et actions, supervisés par l'AMMC.
            </p>
          </div>
          <a href="/cours" class="text-xs font-bold text-emerald-400 hover:underline">Consulter le cours &rarr;</a>
        </div>

      </div>
    </div>

    {/* Section Outils & Pratique en Direct */}
    <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 md:p-12 backdrop-blur-sm mb-16 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div class="space-y-4">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Laboratoire d'apprentissage</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white">Simulez vos stratégies & évaluez vos acquis</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Accédez à la calculatrice d'intérêts composés pour vos projections de rendement et testez vos connaissances boursières grâce au quiz dynamique renouvelé.
        </p>
        <div class="pt-2">
          <a href="/investissement" class="px-6 py-3.5 rounded-xl font-bold text-sm bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition inline-block">
            Accéder à l'Espace Investissement
          </a>
        </div>
      </div>

      <div class="bg-slate-900/80 border border-slate-700/80 rounded-2xl p-6 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
          <span class="text-xs text-slate-400 font-mono">Dictionnaire Financier</span>
          <span class="