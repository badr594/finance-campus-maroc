---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Accueil - Finance Campus Maroc">
  <main class="max-w-6xl mx-auto px-6 py-12">
    
    {/* Section Héro / En-tête principal */}
    <div class="text-center max-w-3xl mx-auto mb-16 pt-6">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 inline-block mb-4">
        Mandat 2026 / 2027 - ENCG Tanger
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight leading-tight">
        Façonnez votre expertise des <span class="text-emerald-400">marchés financiers</span>
      </h1>
      <p class="text-slate-400 text-base md:text-lg leading-relaxed mb-8">
        Bienvenue sur la plateforme officielle du Club Finance. Formations académiques, outils pratiques d'investissement et d2finitions boursières réunis en un seul espace.
      </p>
      
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/cours" class="px-8 py-4 rounded-xl font-bold text-sm bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20">
          Explorer les cours &rarr;
        </a>
        <a href="/dictionnaire" class="px-8 py-4 rounded-xl font-bold text-sm bg-slate-800 border border-slate-700 text-white hover:bg-slate-700 transition">
          Consulter le dictionnaire
        </a>
      </div>
    </div>

    {/* Grille des piliers de la plateforme (Remplacement de la barre répétitive) */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      
      <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm transition hover:border-emerald-500/50">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg mb-6 border border-emerald-500/20">
          01
        </div>
        <h2 class="text-xl font-bold text-white mb-3">Académie & Formations</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Téléchargez les supports de cours en PDF couvrant la gestion de portefeuille, le marché des capitaux et Excel financier.
        </p>
        <a href="/cours" class="text-xs font-semibold text-emerald-400 hover:underline">Accéder aux modules &rarr;</a>
      </div>

      <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm transition hover:border-emerald-500/50">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg mb-6 border border-emerald-500/20">
          02
        </div>
        <h2 class="text-xl font-bold text-white mb-3">Outils d'Investissement</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Simulez vos placements grâce à la calculatrice d'intérêts composés et testez vos connaissances via nos quiz interactifs.
        </p>
        <a href="/investissement" class="text-xs font-semibold text-emerald-400 hover:underline">Découvrir les outils &rarr;</a>
      </div>

      <div class="bg-slate-800/40 border border-slate-700/60 rounded-3xl p-8 backdrop-blur-sm transition hover:border-emerald-500/50">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-lg mb-6 border border-emerald-500/20">
          03
        </div>
        <h2 class="text-xl font-bold text-white mb-3">Lexique & Dictionnaire</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Recherchez instantanément n'importe quel terme technique et obtenez sa définition officielle issue des bases de données.
        </p>
        <a href="/dictionnaire" class="text-xs font-semibold text-emerald-400 hover:underline">Ouvrir le lexique &rarr;</a>
      </div>

    </div>

    {/* Section Institutionnelle / Annonce du Club */}
    <div class="bg-gradient-to-r from-slate-800/60 to-slate-900/80 border border-slate-700/60 rounded-3xl p-8 md:p-12 backdrop-blur-sm flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="space-y-3 max-w-xl">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Engagement Étudiant</span>
        <h2 class="text-2xl md:text-3xl font-extrabold text-white">Rejoignez la dynamique du Club Finance</h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Participez à nos séminaires, simulations boursières et projets professionnels menés au sein de l'ENCG Tanger.
        </p>
      </div>
      <div>
        <a href="/contact" class="px-6 py-3.5 rounded-xl text-sm font-bold bg-slate-800 text-white border border-slate-600 hover:bg-slate-700 transition inline-block">
          Nous contacter
        </a>
      </div>
    </div>

  </main>
</Layout>