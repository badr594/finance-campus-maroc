---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Académie Financière - Club Finance ENCG Tanger">
  <section class="max-w-7xl mx-auto px-6 py-12">
    
    {/* En-tête de l'Académie */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
        Académie Numérique & Certifiante
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
        Apprendre à Investir : Cursus Complet
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed text-justify mb-8">
        Parcours pédagogique progressif en quatre niveaux, enrichi de cours détaillés, de vidéos officielles (AMMC, AMF, Khan Academy), de supports PDF institutionnels et d'exercices interactifs.
      </p>

      {/* Tableau de bord de progression utilisateur */}
      <div class="p-6 bg-slate-900/90 border border-emerald-500/30 rounded-2xl max-w-xl mx-auto text-left shadow-xl">
        <div class="flex justify-between items-center mb-3">
          <span class="text-xs font-bold text-white uppercase tracking-wider">Votre Progression Globale</span>
          <span id="global-progress-text" class="text-xs font-semibold text-emerald-400">0% complété</span>
        </div>
        <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden">
          <div id="global-progress-bar" class="bg-emerald-500 h-full transition-all duration-500" style="width: 0%"></div>
        </div>
        <div class="mt-3 flex justify-between text-[11px] text-slate-400">
          <span>Niveaux : 4</span>
          <span>Leçons validées : <span id="completed-count">0</span> / 4</span>
        </div>
      </div>
    </div>

    {/* SÉLECTEUR DE NIVEAUX (ONGLETS) */}
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <button data-level="1" class="lvl-btn px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-500 text-slate-950 transition shadow-lg shadow-emerald-500/10">Niveau 1 : Débutant</button>
      <button data-level="2" class="lvl-btn px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700 hover:border-emerald-500/50 transition">Niveau 2 : Intermédiaire</button>
      <button data-level="3" class="lvl-btn px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700 hover:border-emerald-500/50 transition">Niveau 3 : Avancé</button>
      <button data-level="4" class="lvl-btn px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700 hover:border-emerald-500/50 transition">Niveau 4 : Professionnel</button>
    </div>


    {/* CONTENU DES NIVEAUX */}

    {/* NIVEAU 1 : DÉBUTANT */}
    <div id="content-lvl-1" class="level-content space-y-12">
      <div class="p-8 bg-slate-800/40 border border-slate-700/60 rounded-3xl">
        <div class="flex justify-between items-start mb-6">
          <div>
            <span class="text-emerald-400 text-xs font-semibold uppercase tracking-wider block mb-1">Niveau 01 - Fondamentaux</span>
            <h2 class="text-2xl font-bold text-white">Introduction à l'Épargne & l'Investissement</h2>
          </div>
          <button data-lesson="lvl1" class="complete-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 border border-slate-700 text-slate-300 hover:border-emerald-500 transition">Marquer comme terminé</button>
        </div>

        <p class="text-slate-300 text-xs md:text-sm leading-relaxed text-justify mb-6">
          Comprendre la différence fondamentale entre stocker son capital (épargne) et le faire fructifier (investissement). L'objectif de ce module est d'assimiler les notions de rendement, de risque inhérent à chaque actif et l'impact destructeur de l'inflation sur le long terme.
        </p>

        {/* Vidéo pédagogique */}
        <div class="mb-8">
          <h3 class="text-sm font-bold text-white mb-3">Ressource Vidéo Pédagogique</h3>
          <div class="aspect-video max-w-3xl mx-auto rounded-2xl overflow-hidden border border-slate-700 shadow-xl bg-slate-900">
            <iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/S7o-s2M6Uq4" title="Introduction à l'investissement" allowfullscreen></iframe>
          </div>
          <span class="block text-center text-[11px] text-slate-400 mt-2">Source officielle : Khan Academy Education</span>
        </div>

        {/* Supports PDF */}
        <div class="p-6 bg-slate-900/80 border border-slate-700/80 rounded-2xl mb-8">
          <h3 class="text-sm font-bold text-white mb-3">Support Pédagogique Officiel (PDF)</h3>
          <div class="flex flex-col md:flex-row items-center justify-between gap-4">
            <div>
              <h4 class="text-xs font-bold text-emerald-400">Guide de l'Épargnant et de l'Investisseur</h4>
              <p class="text-[11px] text-slate-400">Document officiel publié par l'Autorité Marocaine du Marché des Capitaux (AMMC).</p>
            </div>
            <a href="https://www.ammc.ma" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition whitespace-nowrap">
              Consulter sur AMMC.ma
            </a>
          </div>
        </div>

        <div class="p-6 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl">
          <h3 class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">À retenir</h3>
          <p class="text-slate-300 text-xs leading-relaxed text-justify">
            L'inflation érode la valeur nominale de l'épargne non investie. Pour préserver et accroître son capital, l'investisseur doit accepter une exposition mesurée au risque.
          </p>
        </div>
      </div>
    </div>


    {/* NIVEAU 2 : INTERMÉDIAIRE */}
    <div id="content-lvl-2" class="level-content space-y-12 hidden">
      <div class="p-8 bg-slate-800/40 border border-slate-700/60 rounded-3xl">
        <div class="flex justify-between items-start mb-6">
          <div>
            <span class="text-emerald-400 text-xs font-semibold uppercase tracking-wider block mb-1">Niveau 02 - Marchés Cotés</span>
            <h2 class="text-2xl font-bold text-white">Fonctionnement de la Bourse & Diversification</h2>
          </div>
          <button data-lesson="lvl2" class="complete-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 border border-slate-700 text-slate-300 hover:border-emerald-500 transition">Marquer comme terminé</button>
        </div>

        <p class="text-slate-300 text-xs md:text-sm leading-relaxed text-justify mb-6">
          Exploration des marchés financiers organisés, distinction entre actions et obligations, perception des dividendes et application des règles de diversification de portefeuille.
        </p>

        <div class="mb-8">
          <h3 class="text-sm font-bold text-white mb-3">Ressource Vidéo Pédagogique</h3>
          <div class="aspect-video max-w-3xl mx-auto rounded-2xl overflow-hidden border border-slate-700 shadow-xl bg-slate-900">
            <iframe class="w-full h-full" src="https://www.youtube-nocookie.com/embed/5m35_W9d1Uw" title="Comprendre la Bourse" allowfullscreen></iframe>
          </div>
          <span class="block text-center text-[11px] text-slate-400 mt-2">Source officielle : AMF France</span>
        </div>

        <div class="p-6 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl">
          <h3 class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">À retenir</h3>
          <p class="text-slate-300 text-xs leading-relaxed text-justify">
            La diversification permet de réduire la volatilité globale sans sacrifier l'espérance de rendement.
          </p>
        </div>
      </div>
    </div>


    {/* NIVEAU 3 : AVANCÉ */}
    <div id="content-lvl-3" class="level-content space-y-12 hidden">
      <div class="p-8 bg-slate-800/40 border border-slate-700/60 rounded-3xl">
        <div class="flex justify-between items-start mb-6">
          <div>
            <span class="text-emerald-400 text-xs font-semibold uppercase tracking-wider block mb-1">Niveau 03 - Analyse Technique & Fondamentale</span>
            <h2 class="text-2xl font-bold text-white">Analyse Financière & Valorisation d'Entreprise</h2>
          </div>
          <button data-lesson="lvl3" class="complete-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 border border-slate-700 text-slate-300 hover:border-emerald-500 transition">Marquer comme terminé</button>
        </div>

        <p class="text-slate-300 text-xs md:text-sm leading-relaxed text-justify mb-6">
          Maîtrise de la lecture des états financiers, calcul des ratios clés (PER, ROE, BPA) et valorisation intrinsèque des sociétés cotées.
        </p>

        <div class="p-6 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl">
          <h3 class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">À retenir</h3>
          <p class="text-slate-300 text-xs leading-relaxed text-justify">
            Le PER évalue la cherté relative d'une action en comparant son cours à son bénéfice net par action.
          </p>
        </div>
      </div>
    </div>


    {/* NIVEAU 4 : PROFESSIONNEL */}
    <div id="content-lvl-4" class="level-content space-y-12 hidden">
      <div class="p-8 bg-slate-800/40 border border-slate-700/60 rounded-3xl">
        <div class="flex justify-between items-start mb-6">
          <div>
            <span class="text-emerald-400 text-xs font-semibold uppercase tracking-wider block mb-1">Niveau 04 - Gestion Institutionnelle</span>
            <h2 class="text-2xl font-bold text-white">Gestion de Portefeuille & Allocation d'Actifs</h2>
          </div>
          <button data-lesson="lvl4" class="complete-btn px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 border border-slate-700 text-slate-300 hover:border-emerald-500 transition">Marquer comme terminé</button>
        </div>

        <p class="text-slate-300 text-xs md:text-sm leading-relaxed text-justify mb-6">
          Application des modèles de Markowitz, optimisation de la frontière efficiente et gestion des risques institutionnels.
        </p>

        <div class="p-6 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl">
          <h3 class="text-xs font-bold text-emerald-400 uppercase tracking-wider mb-2">À retenir</h3>
          <p class="text-slate-300 text-xs leading-relaxed text-justify">
            L'allocation d'actifs détermine plus de 90 % de la performance à long terme d'un portefeuille.
          </p>
        </div>
      </div>
    </div>


    {/* SECTION EXERCICES PRATIQUES ET EVALUATION */}
    <div class="mt-20 p-8 bg-slate-900/90 border border-emerald-500/30 rounded-3xl shadow-2xl max-w-3xl mx-auto">
      <span class="px-3 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 inline-block mb-4">
        Évaluation des Acquis
      </span>
      <h2 class="text-2xl font-bold text-white mb-4">Quiz d'Évaluation de l'Académie</h2>
      
      <div id="quiz-box">
        <div class="flex justify-between items-center mb-6 text-xs text-slate-400">
          <span id="q-counter">Question 1 sur 3</span>
          <span id="q-score">Score : 0</span>
        </div>

        <h3 id="q-title" class="text-base font-bold text-white mb-6 text-justify"></h3>
        <div id="q-options" class="space-y-3 mb-6"></div>
        <div id="q-feedback" class="p-4 rounded-xl text-xs mb-6 hidden"></div>
        <button id="q-next" class="w-full py-3 rounded-xl text-xs font-bold bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition hidden">
          Question Suivante
        </button>
      </div>

      <div id="quiz-finish" class="text-center hidden">
        <h3 class="text-2xl font-bold text-white mb-3">Félicitations !</h3>
        <p id="quiz-final-msg" class="text-sm text-slate-300 mb-6"></p>
        <button id="quiz-restart" class="px-6 py-3 rounded-xl text-xs font-bold bg-emerald-500 text-slate-950 hover:bg-emerald-400 transition">
          Recommencer le Quiz
        </button>
      </div>
    </div>

  </section>
</Layout>

<script>
  // Exécution sécurisée après le chargement du DOM Astro
  document.addEventListener('DOMContentLoaded', initAcademy);
  document.addEventListener('astro:page-load', initAcademy); // Pour le support de view transitions si activé

  function initAcademy() {
    // 1. Gestion des onglets de niveaux
    const levelButtons = document.querySelectorAll('.lvl-btn');
    levelButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetLevel = btn.getAttribute('data-level');
        
        // Masquer tous les contenus et réinitialiser les boutons
        document.querySelectorAll('.level-content').forEach(content => content.classList.add('hidden'));
        levelButtons.forEach(b => {
          b.className = 'lvl-btn px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-800 text-slate-300 border border-slate-700 hover:border-emerald-500/50 transition';
        });

        // Afficher le contenu cibler et activer le bouton
        const activeContent = document.getElementById(`content-lvl-${targetLevel}`);
        if (activeContent) activeContent.classList.remove('hidden');
        btn.className = 'lvl-btn px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-500 text-slate-950 transition shadow-lg shadow-emerald-500/10';
      });
    });

    // 2. Suivi de progression
    const completedLessons: Record<string, boolean> = { lvl1: false, lvl2: false, lvl3: false, lvl4: false };
    const completeButtons = document.querySelectorAll('.complete-btn');

    completeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const lvlKey = btn.getAttribute('data-lesson');
        if (lvlKey) {
          completedLessons[lvlKey] = true;
          btn.textContent = 'Validé';
          btn.className = 'complete-btn px-4 py-2 rounded-xl text-xs font-semibold bg-emerald-500/20 border border-emerald-500 text-emerald-300';
          
          const total = 4;
          const count = Object.values(completedLessons).filter(Boolean).length;
          const percent = Math.round((count / total) * 100);

          const bar = document.getElementById('global-progress-bar');
          const txt = document.getElementById('global-progress-text');
          const cnt = document.getElementById('completed-count');

          if (bar) bar.style.width = percent + '%';
          if (txt) txt.textContent = percent + '% complété';
          if (cnt) cnt.textContent = count.toString();
        }
      });
    });

    // 3. Quiz interactif
    const questions = [
      {
        q: "Quel est l'impact principal de l'inflation sur une épargne non investie ?",
        options: [
          "Elle augmente le pouvoir d'achat nominal",
          "Elle érode la valeur réelle et le pouvoir d'achat de l'épargne",
          "Elle garantit un rendement fixe supérieur au marché"
        ],
        correct: 1,
        explanation: "L'inflation réduit la quantité de biens et services qu'une même somme d'argent permet d'acheter au fil du temps."
      },
      {
        q: "Que mesure le ratio PER (Price Earning Ratio) en analyse financière ?",
        options: [
          "Le rapport entre le cours de l'action et le bénéfice net par action",
          "Le niveau d'endettement global de l'entreprise",
          "La rentabilité des capitaux propres (ROE)"
        ],
        correct: 0,
        explanation: "Le PER évalue la cherté relative d'une action en comparant son prix de marché à son bénéfice net par action."
      },
      {
        q: "Quel est l'intérêt fondamental de la diversification d'un portefeuille ?",
        options: [
          "Maximiser le risque sur un seul secteur",
          "Diluer le risque spécifique en combinant des actifs décorrélés",
          "Éliminer définitivement tout risque de perte"
        ],
        correct: 1,
        explanation: "La diversification permet de réduire la volatilité globale du portefeuille en évitant de dépendre d'un seul actif."
      }
    ];

    let currentQ = 0;
    let quizScore = 0;

    const qTitle = document.getElementById('q-title');
    const qOptions = document.getElementById('q-options');
    const qCounter = document.getElementById('q-counter');
    const qScoreDisp = document.getElementById('q-score');
    const qFeedback = document.getElementById('q-feedback');
    const qNext = document.getElementById('q-next');
    const quizBox = document.getElementById('quiz-box');
    const quizFinish = document.getElementById('quiz-finish');
    const quizRestart = document.getElementById('quiz-restart');

    function loadQuiz() {
      if (!qTitle || !qOptions || !quizBox || !quizFinish) return;

      quizBox.classList.remove('hidden');
      quizFinish.classList.add('hidden');
      if (qFeedback) qFeedback.classList.add('hidden');
      if (qNext) qNext.classList.add('hidden');

      const curr = questions[currentQ];
      if (qCounter) qCounter.textContent = `Question ${currentQ + 1} sur ${questions.length}`;
      if (qScoreDisp) qScoreDisp.textContent = `Score : ${quizScore}`;
      if (qTitle) qTitle.textContent = curr.q;

      qOptions.innerHTML = '';
      curr.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = 'w-full text-left p-3.5 rounded-xl bg-slate-800/80 border border-slate-700 text-xs text-slate-300 hover:border-emerald-500 transition';
        btn.textContent = opt;
        btn.addEventListener('click', () => answerQuiz(idx));
        qOptions.appendChild(btn);
      });
    }

    function answerQuiz(selectedIdx: number) {
      const curr = questions[currentQ];
      const buttons = qOptions?.querySelectorAll('button');

      buttons?.forEach((btn, idx) => {
        btn.setAttribute('disabled', 'true');
        if (idx === curr.correct) {
          btn.className = 'w-full text-left p-3.5 rounded-xl bg-emerald-500/20 border border-emerald-500 text-xs text-emerald-300 font-semibold';
        } else if (idx === selectedIdx) {
          btn.className = 'w-full text-left p-3.5 rounded-xl bg-red-500/20 border border-red-500 text-xs text-red-300 font-semibold';
        } else {
          btn.className = 'w-full text-left p-3.5 rounded-xl bg-slate-800/40 border border-slate-700 text-xs text-slate-500';
        }
      });

      if (selectedIdx === curr.correct) {
        quizScore++;
        if (qScoreDisp) qScoreDisp.textContent = `Score : ${quizScore}`;
      }

      if (qFeedback) {
        qFeedback.textContent = curr.explanation;
        qFeedback.className = `p-4 rounded-xl text-xs mb-6 ${selectedIdx === curr.correct ? 'bg-emerald-500/10 border border-emerald-500/30 text-emerald-300' : 'bg-amber-500/10 border border-amber-500/30 text-amber-300'}`;
        q