---
const navItems = [
  { name: 'Accueil', href: '/' },
  { name: 'Dictionnaire', href: '/#dictionnaire' },
  { name: 'Cours & Ressources', href: '/cours' },
  { name: 'Actualités', href: '/actualites' },
  { name: 'Club Finance', href: '/club' },
];
---

<header class="sticky top-0 z-50 bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <span class="text-2xl font-black tracking-tight text-white">
        Finance Campus <span class="text-emerald-500">Maroc</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-slate-300 hover:text-emerald-400 transition"
        >
          {item.name}
        </a>
      ))}
    </nav>

    <a 
      href="/cours" 
      class="hidden sm:inline-flex px-5 py-2.5 text-xs font-bold text-slate-950 bg-emerald-500 hover:bg-emerald-400 rounded-xl transition"
    >
      Explorer
    </a>
  </div>
</header>