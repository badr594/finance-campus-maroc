---
const termes = [
  {
    terme: "Action",
    definition: "Titre de propriété représentatif d'une fraction du capital social d'une entreprise. L'actionnaire perçoit des dividendes et dispose d'un droit de vote lors des assemblées générales."
  },
  {
    terme: "Obligation",
    definition: "Titre de créance émis par une entreprise ou un État pour emprunter des capitaux sur les marchés. L'émetteur s'engage à verser un intérêt régulier (le coupon) et à rembourser le capital à l'échéance."
  },
  {
    terme: "VAN (Valeur Actuelle Nette)",
    definition: "Indicateur de rentabilité d'un investissement mesurant la différence entre les flux de trésorerie futurs actualisés et le montant du capital investi initialement. Une VAN positive indique un projet créateur de valeur."
  },
  {
    terme: "TRI (Taux Rendement Interne)",
    definition: "Taux d'actualisation qui annule la Valeur Actuelle Nette (VAN) d'un projet d'investissement. Il représente le taux de rentabilité implicite de l'investissement."
  },
  {
    terme: "WACC / CMPC (Coût Moyen Pondéré du Capital)",
    definition: "Taux de rentabilité minimal exigé par l'ensemble des apporteurs de capitaux (actionnaires et créanciers) pour financer l'activité de l'entreprise."
  },
  {
    terme: "EBITDA / EBE",
    definition: "Indicateur financier mesurant la rentabilité brute de l'exploitation d'une entreprise, indépendamment de ses décisions de financement, de politique d'amortissement et de fiscalité."
  },
  {
    terme: "Effet de Levier Financier",
    definition: "Utilisation de l'endettement pour augmenter la rentabilité des capitaux propres de l'entreprise, à condition que le coût de la dette soit inférieur à la rentabilité économique."
  },
  {
    terme: "BFR (Besoin en Fonds de Roulement)",
    definition: "Montant nécessaire pour financer le décalage de trésorerie issu de l'activité courante de l'entreprise (différence entre les créances clients + stocks et les dettes fournisseurs)."
  },
  {
    terme: "FRNG (Fonds de Roulement Net Global)",
    definition: "Excédent des ressources stables sur les emplois stables d'une entreprise. Il indique si la structure financière à long terme parvient à financer les actifs immobilisés."
  },
  {
    terme: "Flux de Trésorerie Libres (Free Cash Flow)",
    definition: "Trésorerie générée par l'exploitation après financement des investissements nécessaires au maintien ou au développement de l'outil de production."
  },
  {
    terme: "PER (Price Earnings Ratio)",
    definition: "Ratio boursier mesurant le rapport entre le cours d'une action et le bénéfice net par action. Il indique combien de fois les investisseurs sont prêts à payer le bénéfice."
  },
  {
    terme: "ROIC (Return on Invested Capital)",
    definition: "Ratio mesurant la rentabilité des capitaux investis dans l'activité opérationnelle par les actionnaires et les créanciers."
  },
  {
    terme: "ROE (Return on Equity)",
    definition: "Ratio mesurant la rentabilité des capitaux propres apportés par les actionnaires d'une entreprise."
  },
  {
    terme: "Gouvernance d'Entreprise",
    definition: "Ensemble des règles, processus et structures par lesquels une entreprise est dirigée et contrôlée, visant à équilibrer les intérêts des actionnaires, dirigeants et parties prenantes."
  },
  {
    terme: "Titrisation",
    definition: "Technique financière consistant à transformer des créances illiquides (ex: prêts bancaires) en titres négociables sur les marchés financiers."
  },
  {
    terme: "Bourse des Valeurs de Casablanca (BVC)",
    definition: "Marché officiel des actions et obligations au Maroc, régulé par l'AMMC, permettant aux entreprises de lever des capitaux et aux investisseurs de négocier des titres."
  },
  {
    terme: "AMMC (Autorité Marocaine du Marché des Capitaux)",
    definition: "Organisme public de régulation veillant à la protection de l'épargne investie en instruments financiers et au bon fonctionnement des marchés financiers au Maroc."
  },
  {
    terme: "Sukuk",
    definition: "Certificats d'investissement conformes aux principes de la finance islamique, adossés à des actifs réels, procurant des rendements issus de l'exploitation ou de la location de ces actifs."
  },
  {
    terme: "Ijarah",
    definition: "Contrat de crédit-bail en finance islamique par lequel une institution financière achète un bien pour le louer à un client sur une période déterminée avec option d'achat à l'échéance."
  },
  {
    terme: "Murabaha",
    definition: "Mode de financement en finance islamique reposant sur un contrat d'achat et de revente d'un bien avec une marge bénéficiaire convenue à l'avance entre la banque et le client."
  },
  {
    terme: "Mudaraba",
    definition: "Partenariat financier dans lequel un apporteur de capitaux (Rab al-Mal) fournit les fonds et un entrepreneur (Mudarib) apporte son expertise pour gérer un projet, avec partage des profits."
  },
  {
    terme: "Musharaka",
    definition: "Contrat d'association dans lequel deux ou plusieurs parties apportent du capital et participent aux profits et aux pertes au prorata de leurs apports respectifs."
  },
  {
    terme: "OPCVM",
    definition: "Organisme de Placement Collectif en Valeurs Mobilières permettant de collecter de l'épargne auprès d'investisseurs pour la placer dans un portefeuille diversifié d'actions ou d'obligations."
  },
  {
    terme: "Marché Monétaire",
    definition: "Marché financier de court terme sur lequel les banques, institutions financières et entreprises s'échangent des liquidités et des titres de créances négociables (TCN)."
  },
  {
    terme: "Marché Primaire vs Secondaire",
    definition: "Le marché primaire est le marché sur lequel les nouveaux titres sont émis pour la première fois. Le marché secondaire est le marché de la revente d'occasion de ces titres."
  }
];
---

<section class="max-w-7xl mx-auto px-6 py-12">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-3">
      Dictionnaire Financier Interactif
    </span>
    <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">
      Explorez les concepts clés de la Finance
    </h1>
    <p class="text-slate-400 text-sm md:text-base leading-relaxed text-justify">
      Accédez rapidement aux définitions essentielles en finance d'entreprise, marchés des capitaux et finance alternative pour réussir votre parcours académique à l'ENCG Tanger.
    </p>

    {/* Barre de recherche */}
    <div class="mt-8 relative max-w-xl mx-auto">
      <input
        type="text"
        id="search-input"
        placeholder="Rechercher un terme (ex: WACC, Sukuk, VAN, EBITDA)..."
        class="w-full px-5 py-3.5 bg-slate-900/80 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500/80 focus:ring-1 focus:ring-emerald-500/80 transition text-sm shadow-inner"
      />
    </div>
  </div>

  {/* Grille des définitions */}
  <div id="dictionary-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {termes.map((item) => (
      <div class="dict-card p-6 bg-slate-800/40 border border-slate-700/60 rounded-2xl hover:border-emerald-500/40 transition flex flex-col justify-between">
        <div>
          <h3 class="dict-title text-lg font-bold text-white mb-2">{item.terme}</h3>
          <p class="dict-def text-slate-300 text-xs leading-relaxed text-justify">{item.definition}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const cards = document.querySelectorAll('.dict-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

      cards.forEach((card) => {
        const title = card.querySelector('.dict-title')?.textContent?.toLowerCase() || '';
        const def = card.querySelector('.dict-def')?.textContent?.toLowerCase() || '';

        if (title.includes(query) || def.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>