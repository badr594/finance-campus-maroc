---
---

<section class="max-w-7xl mx-auto px-6 py-16">
  <div class="text-center max-w-4xl mx-auto mb-12">
    <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 inline-block mb-4">
      Mandat 2026 / 2027 — Club Finance ENCG Tanger
    </span>
    
    {/* Nouveau titre d'accroche personnalisé */}
    <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-6 tracking-tight leading-tight">
      La plateforme dédiée aux étudiants de l'ENCG Tanger passionnés par la Finance
    </h1>
    
    {/* Description épurée */}
    <p class="text-slate-300 text-sm md:text-base leading-relaxed text-justify mb-8">
      Un espace académique et interactif conçu pour approfondir vos connaissances en finance d'entreprise, comprendre les dynamiques des marchés des capitaux et maîtriser les fondements des finances alternatives au Maroc et à l'international.
    </p>

    {/* Barre de recherche interactive */}
    <div class="relative max-w-xl mx-auto mb-6">
      <input
        type="text"
        id="search-input"
        placeholder="Rechercher un concept financier (ex: WACC, Sukuk, VAN)..."
        class="w-full px-5 py-3.5 bg-slate-900/90 border border-slate-700/80 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500/80 focus:ring-1 focus:ring-emerald-500/80 transition text-sm shadow-inner"
      />
    </div>

    {/* Badges des domaines d'expertise */}
    <div class="flex flex-wrap justify-center gap-3 text-xs">
      <span class="text-slate-400 self-center mr-2 font-medium">Axes majeurs :</span>
      <span class="px-3 py-1.5 rounded-lg bg-slate-800/60 border border-slate-700 text-slate-300">Finance d'entreprise</span>
      <span class="px-3 py-1.5 rounded-lg bg-slate-800/60 border border-slate-700 text-slate-300">Marchés des capitaux</span>
      <span class="px-3 py-1.5 rounded-lg bg-slate-800/60 border border-slate-700 text-slate-300">Finance islamique</span>
      <span class="px-3 py-1.5 rounded-lg bg-slate-800/60 border border-slate-700 text-slate-300">Analyse financière</span>
    </div>
  </div>

  {/* Zone d'affichage dynamique du résultat de recherche */}
  <div id="search-results-container" class="max-w-2xl mx-auto mt-6 hidden">
    <div class="p-6 bg-slate-800/60 border border-emerald-500/40 rounded-2xl shadow-lg">
      <h3 id="result-title" class="text-base font-bold text-emerald-400 mb-2"></h3>
      <p id="result-def" class="text-slate-300 text-xs leading-relaxed text-justify"></p>
    </div>
  </div>
</section>

<script>
  import dictionnaireData from '../data/dictionnaire.json';

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const resultsContainer = document.getElementById('search-results-container');
  const resultTitle = document.getElementById('result-title');
  const resultDef = document.getElementById('result-def');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

      if (query.length < 2) {
        resultsContainer?.classList.add('hidden');
        return;
      }

      const match = dictionnaireData.find((item: any) => 
        item.terme.toLowerCase().includes(query) || item.definition.toLowerCase().includes(query)
      );

      if (match && resultsContainer && resultTitle && resultDef) {
        resultTitle.textContent = match.terme;
        resultDef.textContent = match.definition;
        resultsContainer.classList.remove('hidden');
      } else {
        resultsContainer?.classList.add('hidden');
      }
    });
  }
</script>